<Project Sdk="Microsoft.NET.Sdk">

  <!-- Achievements for Vanilla Achievements Expanded (docs/TECH_DETAILS.md, section 3.4). Built into Optional/ (not
       Assemblies/): NetrunMod loads it only when VAE is active. The main assembly does not depend on VAE. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NetrunVAE</AssemblyName>
    <RootNamespace>NetrunVAE</RootNamespace>
    <Version>0.6.1</Version>
    <OutputPath>..\Optional\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <RIMWORLD_DIR Condition="'$(RIMWORLD_DIR)' == ''">E:\SteamLibrary\steamapps\common\RimWorld</RIMWORLD_DIR>
    <LocalGame Condition="Exists('$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll')">true</LocalGame>
  </PropertyGroup>

  <ItemGroup Condition="'$(LocalGame)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RIMWORLD_DIR)\..\..\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(LocalGame)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- VAE's assembly: downloaded by CI from the VAE repository into lib/ (see .github/workflows/build.yml). -->
    <Reference Include="AchievementsExpanded">
      <HintPath>lib\AchievementsExpanded.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HackingExpansionNetrun">
      <HintPath>..\Assemblies\HackingExpansionNetrun.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
