<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Trace lock joins Hacking Expansion's ICE. Core-command ICE and Black ICE inherit the list from USH_ICE. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/*[defName="USH_ICE"]/hackingOutcomes</xpath>
    <value>
      <li>NR_TraceLock</li>
    </value>
  </Operation>

  <!-- The cyberpod can be uninstalled and moved like a cryptosleep casket; scenarios hand it over packed. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/minifiedDef</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="USH_Cyberpod"]</xpath>
      <value>
        <minifiedDef>MinifiedThing</minifiedDef>
      </value>
    </nomatch>
  </Operation>
  <!-- A minified thing needs a storage category and an authored mass (config errors otherwise). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/thingCategories</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="USH_Cyberpod"]</xpath>
      <value>
        <thingCategories>
          <li>BuildingsMisc</li>
        </thingCategories>
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/statBases/Mass</xpath>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/statBases</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/statBases</xpath>
        <value>
          <Mass>60</Mass>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="USH_Cyberpod"]</xpath>
        <value>
          <statBases>
            <Mass>60</Mass>
          </statBases>
        </value>
      </nomatch>
    </nomatch>
  </Operation>

  <!-- The Netrun coprocessor links to the cyberpod like Hacking Expansion's own coprocessors. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
    <value>
      <li>NR_NetrunCoprocessor</li>
    </value>
  </Operation>

  <!-- Hackers inside a cyberpod are stealthier: fewer ICE outcomes and less Heat. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="HackingStealth"]/parts</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="HackingStealth"]</xpath>
      <value>
        <parts>
          <li Class="Netrun.StatPart_InCyberpod" />
        </parts>
      </value>
    </nomatch>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="HackingStealth"]/parts</xpath>
      <value>
        <li Class="Netrun.StatPart_InCyberpod" />
      </value>
    </match>
  </Operation>

  <!-- Hacking Expansion's buildings go to our Cyberspace tab: the cyberpod, its three coprocessors (set on their abstract base)
       and the data server. The Mechhive disruptor is a turret and stays under Security. Conditional: silent if HE renames anything. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/designationCategory</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="USH_Cyberpod"]/designationCategory</xpath>
      <value>
        <designationCategory>NR_Cyberspace</designationCategory>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="USH_CoprocessorBase"]/designationCategory</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[@Name="USH_CoprocessorBase"]/designationCategory</xpath>
      <value>
        <designationCategory>NR_Cyberspace</designationCategory>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="USH_DataServer"]/designationCategory</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="USH_DataServer"]/designationCategory</xpath>
      <value>
        <designationCategory>NR_Cyberspace</designationCategory>
      </value>
    </match>
  </Operation>

  <!-- Cyberdata is a data chip: Hacking Expansion gives it 0.8 kg, heavier than steel. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="USH_CyberdataBase"]/statBases/Mass</xpath>
    <value>
      <Mass>0.05</Mass>
    </value>
  </Operation>

</Patch>
