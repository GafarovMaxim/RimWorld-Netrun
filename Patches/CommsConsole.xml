<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- The vanilla comms console doubles as the network terminal. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="CommsConsole"]/comps</xpath>
    <value>
      <li Class="Netrun.CompProperties_NetTerminal" />
    </value>
  </Operation>

  <!-- Renamed: it is the colony's network console now. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="CommsConsole"]/label</xpath>
    <value>
      <label>network console</label>
    </value>
  </Operation>

</Patch>
