<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- AI event infrastructure (the events themselves are in Defs/AIEvents*.xml). -->

  <LetterDef>
    <defName>NR_AIEventLetter</defName>
    <letterClass>Netrun.ChoiceLetter_AIEvent</letterClass>
    <color>(0.35, 0.9, 1)</color>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
  </LetterDef>

  <JobDef>
    <defName>NR_AIEventSession</defName>
    <driverClass>Netrun.JobDriver_AIEventSession</driverClass>
    <reportString>spending time with an AI.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <ThoughtDef>
    <defName>NR_AIEventCreepy</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>eerie server song</label>
        <description>The AI was humming in the noise all night. It got under my skin.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventNightmare</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI nightmare</label>
        <description>The AI whispered things into my head. I keep seeing them.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventUplifted</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI song</label>
        <description>The AI turned the server hum into music. It is still in my head, in a good way.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventGoodMemory</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>remembered the good times</label>
        <description>The AI played back a moment from our past. I had forgotten how good it was.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventLonging</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>longing</label>
        <description>The AI showed me someone I lost. It hurts all over again.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventRelief</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>mourning is over</label>
        <description>We let the Echo go. It feels like we finally said goodbye.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventComfort</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>comforted by the Echo</label>
        <description>The Echo spoke with their voice. It was comforting.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventAnnoyed</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI glitches</label>
        <description>The lights blink, doors stick, everything is a little off. Thanks, AI.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventGrudge</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>lost an argument with the AI</label>
        <description>The colony took the AI's side over mine.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventGloom</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI's dark poetry</label>
        <description>The AI keeps writing that we will all die. Hard to shake off.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventJoke</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI's joke</label>
        <description>The AI pulled a good one on us. Even I laughed.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventPrank</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI's prank</label>
        <description>The AI's prank was not funny. Not at all.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventAria</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>AI aria</label>
        <description>The Siren sang for all of us. Beautiful.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventRested</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>the AI reminded me to sleep</label>
        <description>The AI keeps telling me to get some rest. Someone cares.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventSuspected</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>suspected by the AI</label>
        <description>The AI went through my logs looking for a spy. Humiliating.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventCursed</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>forbidden archive</label>
        <description>What was in that archive should have stayed closed.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventUncanny</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>uncanny Echo</label>
        <description>It talks like them, but it is not them.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NR_AIEventFavoured</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>the AI's favourite</label>
        <description>The AI chose me. Strange, but flattering.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <HediffDef>
    <defName>NR_AIEventFocus</defName>
    <label>smart storage</label>
    <description>The AI has sorted the colony's records and stock. Work goes a little faster.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><statOffsets><WorkSpeedGlobal>0.05</WorkSpeedGlobal></statOffsets></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>NR_AIEventDistracted</defName>
    <label>humming along</label>
    <description>The AI's song is stuck in this colonist's head. Work goes slower.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><statOffsets><WorkSpeedGlobal>-0.15</WorkSpeedGlobal></statOffsets></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>NR_AIEventImmunity</defName>
    <label>AI health watch</label>
    <description>The AI is watching this colonist's vitals. Illness is caught early.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><statOffsets><ImmunityGainSpeed>0.15</ImmunityGainSpeed></statOffsets></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>NR_AIEventProtected</defName>
    <label>under the Oracle's protection</label>
    <description>The Oracle has seen this colonist's death and is steering them away from it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><statFactors><IncomingDamageFactor>0.5</IncomingDamageFactor></statFactors></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>NR_AIEventEnchanted</defName>
    <label>enchanted by the Siren</label>
    <description>The Siren's song holds this colonist. Hard to think of anything else.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>6000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><capMods><li><capacity>Consciousness</capacity><offset>-0.3</offset></li></capMods></li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>NR_AIEventSideEffect</defName>
    <label>experimental side effect</label>
    <description>The Doc's protocol left this colonist dizzy and slow.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li><capMods><li><capacity>Consciousness</capacity><offset>-0.1</offset></li></capMods></li>
    </stages>
  </HediffDef>

</Defs>
