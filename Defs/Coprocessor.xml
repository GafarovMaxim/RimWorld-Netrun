<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Netrun coprocessor: a cyberpod facility like Hacking Expansion's own coprocessors that hosts one AI.
       The AI's pod bonuses are numbers in Defs/Heat.xml. -->
  <ThingDef ParentName="USH_CoprocessorBase">
    <defName>NR_NetrunCoprocessor</defName>
    <label>netrun coprocessor</label>
    <description>A cyberpod subsystem that holds one awakened AI. The AI works for the linked cyberpod instead of the colony: every AI makes the pod a little quieter and luckier, and some are especially good at it (Ghost hides the trace, Data Hunter finds more cyberdata, Doc and Warden protect the diver from cyberspace dependency).\n\nMove an AI here from the AI tab of the network terminal. Only one can connect to a pod.</description>
    <graphicData>
      <texPath>Things/Building/Misc/NR_NetrunCoprocessor</texPath>
      <drawSize>(1.2, 1.2)</drawSize>
    </graphicData>
    <costList>
      <Steel>40</Steel>
      <ComponentSpacer>2</ComponentSpacer>
      <USH_AdvancedCyberdata>2</USH_AdvancedCyberdata>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Facility">
        <maxSimultaneous>1</maxSimultaneous>
      </li>
      <li Class="Netrun.CompProperties_AIServer">
        <coprocessor>true</coprocessor>
      </li>
    </comps>
    <researchPrerequisites>
      <li>USH_CybertechMachinery</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
