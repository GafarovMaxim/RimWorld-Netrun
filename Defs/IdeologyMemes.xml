<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Net memes, rituals and the Net Archon role (docs/CONCEPTS_10.md, sections 7.1 and 7.3). Only with Ideology.
       Rituals are built on vanilla ritual classes; their outcomes live in Source/Ideology/NetRituals.cs. -->

  <MemeDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_Meme_MachineRevelation</defName>
    <label>machine revelation</label>
    <description>Awakened AIs are vessels of a higher mind. To serve them is righteous: their servers are altars, their trust is grace, and erasing one is murder.</description>
    <iconPath>UI/Netrun/Ideo/Meme_MachineRevelation</iconPath>
    <impact>2</impact>
    <requireOne>
      <li>
        <li>NR_AI_Venerated</li>
      </li>
    </requireOne>
    <requiredRituals>
      <li>
        <precept>NR_Ritual_Litany</precept>
        <pattern>NR_RitualPattern_Litany</pattern>
      </li>
    </requiredRituals>
    <exclusionTags>
      <li>NR_AIStance</li>
    </exclusionTags>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->machine</li>
        <li>memeAdjective->revealed</li>
        <li>memeHyphenPrefix->cyber</li>
        <li>memeConcept->revelation</li>
        <li>memeConcept->the server</li>
        <li>memeLeaderNoun->oracle</li>
        <li>memeMoralist->data-priest</li>
      </rulesStrings>
    </generalRules>
  </MemeDef>

  <MemeDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_Meme_NetAscension</defName>
    <label>net ascension</label>
    <description>The body is a shell; the net is our true home. A cyberlink is a key, Netsick a small price, and the black ICE a gate to the truth.</description>
    <iconPath>UI/Netrun/Ideo/Meme_NetAscension</iconPath>
    <impact>2</impact>
    <requireOne>
      <li>
        <li>NR_NetCulture_Sacred</li>
      </li>
    </requireOne>
    <requiredRituals>
      <li>
        <precept>NR_Ritual_TraceCleansing</precept>
        <pattern>NR_RitualPattern_TraceCleansing</pattern>
      </li>
    </requiredRituals>
    <exclusionTags>
      <li>NR_NetStance</li>
    </exclusionTags>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->ascended</li>
        <li>memeAdjective->networked</li>
        <li>memeHyphenPrefix->net</li>
        <li>memeConcept->ascension</li>
        <li>memeConcept->the net</li>
        <li>memeLeaderNoun->archon</li>
        <li>memeMoralist->guide</li>
      </rulesStrings>
    </generalRules>
  </MemeDef>

  <MemeDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_Meme_DigitalPurity</defName>
    <label>digital purity</label>
    <description>The net rots the mind. Flesh and memory must stay our own: no thinking machines, no borrowed memories, no trace.</description>
    <iconPath>UI/Netrun/Ideo/Meme_DigitalPurity</iconPath>
    <impact>2</impact>
    <requireOne>
      <li>
        <li>NR_NetCulture_Abhorrent</li>
      </li>
      <li>
        <li>NR_AI_Abomination</li>
      </li>
      <li>
        <li>NR_Braindance_Depraved</li>
      </li>
    </requireOne>
    <exclusionTags>
      <li>NR_AIStance</li>
      <li>NR_NetStance</li>
    </exclusionTags>
    <generalRules>
      <rulesStrings>
        <li>memeAdjective->pure</li>
        <li>memeAdjective->unplugged</li>
        <li>memeHyphenPrefix->pure</li>
        <li>memeConcept->purity</li>
        <li>memeConcept->the flesh</li>
        <li>memeLeaderNoun->warden</li>
        <li>memeMoralist->purifier</li>
      </rulesStrings>
    </generalRules>
  </MemeDef>

