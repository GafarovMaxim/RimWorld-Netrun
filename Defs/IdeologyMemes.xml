  <RitualObligationTargetFilterDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualTarget_AIServer</defName>
    <workerClass>RitualObligationTargetWorker_ThingDef</workerClass>
    <thingDefs>
      <li>NR_AIServer</li>
    </thingDefs>
  </RitualObligationTargetFilterDef>

  <RitualObligationTargetFilterDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualTarget_Console</defName>
    <workerClass>RitualObligationTargetWorker_ThingDef</workerClass>
    <!-- Filled in code at startup with every comms console, modded ones too (NetTerminalDefs) -->
    <thingDefs>
      <li>CommsConsole</li>
    </thingDefs>
  </RitualObligationTargetFilterDef>

  <RitualTargetFilterDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualTargetSelected</defName>
    <workerClass>RitualTargetFilter_SelectedThing</workerClass>
  </RitualTargetFilterDef>

  <RitualBehaviorDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualBehavior_NetSermon</defName>
    <workerClass>Netrun.RitualBehaviorWorker_Net</workerClass>
    <durationTicks>5000</durationTicks>
    <spectatorsLabel>Participants</spectatorsLabel>
    <spectatorGerund>participate</spectatorGerund>
    <roles>
      <li Class="RitualRoleTag">
        <label>speaker</label>
        <id>speaker</id>
        <tag>Moralist</tag>
        <precept>IdeoRole_Moralist</precept>
        <required>True</required>
        <substitutable>true</substitutable>
        <maxCount>1</maxCount>
        <countsAsParticipant>False</countsAsParticipant>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <visualEffectDef>NR_RitualVfx_Net</visualEffectDef>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.85</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>speaker</roleId>
            <dutyDef>SpeakOnCellFacingSpectators</dutyDef>
            <speakerInteraction>Speech_DateRitual</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_BesideThing" />
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <visualEffectDef>NR_RitualVfx_Net</visualEffectDef>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>0.15</percentage>
          </li>
        </endTriggers>
      </li>
    </stages>
  </RitualBehaviorDef>

  <!-- Trace cleansing: up to three netrunners at the console, no spectators; their Intellectual sets the quality
       (Maxim, 2026-10-16). -->
  <RitualBehaviorDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualBehavior_TraceCleansing</defName>
    <workerClass>Netrun.RitualBehaviorWorker_Net</workerClass>
    <durationTicks>5000</durationTicks>
    <spectatorsLabel>Participants</spectatorsLabel>
    <spectatorGerund>participate</spectatorGerund>
    <spectatorFilter Class="Netrun.RitualSpectatorFilter_None">
      <description>Only the three netrunners at the console take part.</description>
    </spectatorFilter>
    <roles>
      <li Class="RitualRoleColonist">
        <label>netrunner</label>
        <categoryLabel>netrunners</categoryLabel>
        <id>netrunner1</id>
        <mergeId>netrunner</mergeId>
        <required>True</required>
        <maxCount>1</maxCount>
        <usedSkill>Intellectual</usedSkill>
        <defaultForSelectedColonist>true</defaultForSelectedColonist>
        <allowChild>false</allowChild>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
        <blocksSocialInteraction>true</blocksSocialInteraction>
      </li>
      <li Class="RitualRoleColonist">
        <label>netrunner</label>
        <categoryLabel>netrunners</categoryLabel>
        <id>netrunner2</id>
        <mergeId>netrunner</mergeId>
        <maxCount>1</maxCount>
        <usedSkill>Intellectual</usedSkill>
        <allowChild>false</allowChild>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
        <blocksSocialInteraction>true</blocksSocialInteraction>
      </li>
      <li Class="RitualRoleColonist">
        <label>netrunner</label>
        <categoryLabel>netrunners</categoryLabel>
        <id>netrunner3</id>
        <mergeId>netrunner</mergeId>
        <maxCount>1</maxCount>
        <usedSkill>Intellectual</usedSkill>
        <allowChild>false</allowChild>
        <mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
        <blocksSocialInteraction>true</blocksSocialInteraction>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <visualEffectDef>NR_RitualVfx_Net</visualEffectDef>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>netrunner1</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_OnInteractionCell" />
              <li Class="RitualPosition_InCircle">
                <distRange>1~2</distRange>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>netrunner2</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_InCircle">
                <distRange>1~2</distRange>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>netrunner3</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_InCircle">
                <distRange>1~2</distRange>
              </li>
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualPatternDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualPattern_Litany</defName>
    <playsIdeoMusic>false</playsIdeoMusic>
    <nameMaker>NR_NamerLitany</nameMaker>
    <shortDescOverride>litany of data</shortDescOverride>
    <descOverride>At the AI server a speaker reads the data aloud and the faithful listen. The awakened AIs listen too: a good litany earns their trust; a poor one leaves them unheard and hungry.</descOverride>
    <iconPathOverride>UI/Netrun/Ideo/Ritual_Litany</iconPathOverride>
    <canStartAnytime>true</canStartAnytime>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualFreeStartIntervalDaysRange>10</ritualFreeStartIntervalDaysRange>
    <ritualObligationTargetFilter>NR_RitualTarget_AIServer</ritualObligationTargetFilter>
    <ritualTargetFilter>NR_RitualTargetSelected</ritualTargetFilter>
    <ritualBehavior>NR_RitualBehavior_NetSermon</ritualBehavior>
    <ritualOutcomeEffect>NR_RitualOutcome_Litany</ritualOutcomeEffect>
    <tags>
      <li>NR_Litany</li>
    </tags>
    <patternGroupTag>NR_Litany</patternGroupTag>
  </RitualPatternDef>

  <RitualPatternDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualPattern_TraceCleansing</defName>
    <playsIdeoMusic>false</playsIdeoMusic>
    <nameMaker>NR_NamerTraceCleansing</nameMaker>
    <shortDescOverride>trace cleansing</shortDescOverride>
    <descOverride>Up to three netrunners at the comms console scrub the colony's trace from the net, without a fixer. The sharper their minds, the cleaner the job. Once in 15 days.</descOverride>
    <iconPathOverride>UI/Netrun/Ideo/Ritual_TraceCleansing</iconPathOverride>
    <canStartAnytime>true</canStartAnytime>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualFreeStartIntervalDaysRange>15</ritualFreeStartIntervalDaysRange>
    <ritualObligationTargetFilter>NR_RitualTarget_Console</ritualObligationTargetFilter>
    <ritualTargetFilter>NR_RitualTargetSelected</ritualTargetFilter>
    <ritualBehavior>NR_RitualBehavior_TraceCleansing</ritualBehavior>
    <ritualOutcomeEffect>NR_RitualOutcome_TraceCleansing</ritualOutcomeEffect>
    <tags>
      <li>NR_TraceCleansing</li>
    </tags>
    <patternGroupTag>NR_TraceCleansing</patternGroupTag>
  </RitualPatternDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_Ritual_Litany</defName>
    <label>litany of data</label>
    <description>A sermon at the AI server. The AIs' trust grows with a good one.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <iconPath>UI/Netrun/Ideo/Ritual_Litany</iconPath>
    <preceptClass>Precept_Ritual</preceptClass>
    <ritualPatternBase>NR_RitualPattern_Litany</ritualPatternBase>
    <usesIdeoVisualEffects>false</usesIdeoVisualEffects>
    <requiredMemes>
      <li>NR_Meme_MachineRevelation</li>
    </requiredMemes>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_Ritual_TraceCleansing</defName>
    <label>trace cleansing</label>
    <description>The colony scrubs its trace together at the comms console. Heat goes down with a good one.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <iconPath>UI/Netrun/Ideo/Ritual_TraceCleansing</iconPath>
    <preceptClass>Precept_Ritual</preceptClass>
    <ritualPatternBase>NR_RitualPattern_TraceCleansing</ritualPatternBase>
    <usesIdeoVisualEffects>false</usesIdeoVisualEffects>
    <!-- Only with a net meme (Maxim, 2026-10-14). -->
    <requiredMemes>
      <li>NR_Meme_NetAscension</li>
      <li>NR_Meme_MachineRevelation</li>
    </requiredMemes>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>

  <RitualOutcomeEffectDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualOutcome_Litany</defName>
    <description>Depending on quality, the AIs' trust grows by 5 to 15 and the participants feel uplifted; a poor litany leaves the AIs hungry.</description>
    <workerClass>Netrun.RitualOutcomeEffectWorker_Litany</workerClass>
    <allowAttachableOutcome>false</allowAttachableOutcome>
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1, 0.0)</li>
            <li>(5, 0.2)</li>
            <li>(10, 0.3)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Unheard</label>
        <chance>0.15</chance>
        <memory>NR_Ritual_LitanyBad</memory>
        <description>The {0} fell flat. The servers hummed on as if nobody had spoken.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Heard</label>
        <chance>0.65</chance>
        <memory>NR_Ritual_LitanyGood</memory>
        <description>The {0} was heard. The AIs answered with a flicker of light.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Communion</label>
        <chance>0.2</chance>
        <memory>NR_Ritual_LitanyGreat</memory>
        <description>The {0} became a communion. For a moment, everyone felt the machine think.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

  <RitualOutcomeEffectDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>NR_RitualOutcome_TraceCleansing</defName>
    <description>Depending on quality, the colony's Heat drops by 5 to 15.</description>
    <workerClass>Netrun.RitualOutcomeEffectWorker_TraceCleansing</workerClass>
    <allowAttachableOutcome>false</allowAttachableOutcome>
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1, 0.0)</li>
            <li>(3, 0.15)</li>
          </points>
        </curve>
      </li>
      <li Class="Netrun.RitualOutcomeComp_RolesSkill">
        <label>netrunners' intellectual</label>
        <labelAbstract>netrunners' intellectual (average)</labelAbstract>
        <skillDef>Intellectual</skillDef>
        <roleIds>
          <li>netrunner1</li>
          <li>netrunner2</li>
          <li>netrunner3</li>
          <li>netrunner</li>
        </roleIds>
        <curve>
          <points>
            <li>(0, 0.0)</li>
            <li>(5, 0.1)</li>
            <li>(10, 0.3)</li>
            <li>(15, 0.45)</li>
            <li>(20, 0.6)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Sloppy</label>
        <chance>0.2</chance>
        <memory>NR_Ritual_CleansingBad</memory>
        <description>The {0} was sloppy: a little scrubbed, a lot left behind.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Clean</label>
        <chance>0.6</chance>
        <memory>NR_Ritual_CleansingGood</memory>
        <description>The {0} went clean: the logs are quieter now.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Ghosted</label>
        <chance>0.2</chance>
        <memory>NR_Ritual_CleansingGreat</memory>
        <description>The {0} left the colony a ghost in the net.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" Name="NR_RitualThoughtBase" Abstract="True">
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
  </ThoughtDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" ParentName="NR_RitualThoughtBase">
    <defName>NR_Ritual_LitanyBad</defName>
    <stages><li><label>unheard litany</label><description>We read to the machines and they did not listen.</description><baseMoodEffect>-2</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" ParentName="NR_RitualThoughtBase">
    <defName>NR_Ritual_LitanyGood</defName>
    <stages><li><label>heard litany</label><description>The machines heard us.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" ParentName="NR_RitualThoughtBase">
    <defName>NR_Ritual_LitanyGreat</defName>
    <stages><li><label>machine communion</label><description>For a moment I felt the machine think. I will never forget it.</description><baseMoodEffect>8</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" ParentName="NR_RitualThoughtBase">
    <defName>NR_Ritual_CleansingBad</defName>
    <stages><li><label>sloppy cleansing</label><description>We left half our trace behind.</description><baseMoodEffect>-1</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" ParentName="NR_RitualThoughtBase">
    <defName>NR_Ritual_CleansingGood</defName>
    <stages><li><label>clean trace</label><description>The logs are quieter. We are safer.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology" ParentName="NR_RitualThoughtBase">
    <defName>NR_Ritual_CleansingGreat</defName>
