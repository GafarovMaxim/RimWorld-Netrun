<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- All fixer balance numbers. Tweak here, no code changes needed. -->
  <Netrun.FixerSettingsDef>
    <defName>NR_Fixers</defName>

    <!-- Pool: size, rotation period in days, reputation that pins a fixer for good,
         reputation that reveals the fixer's trait -->
    <poolSize>5</poolSize>
    <!-- At most this many pinned fixers at once (the next one waits for a free place) -->
    <maxPinned>2</maxPinned>
    <rotationDays>7~10</rotationDays>
    <!-- Fixers v2 (docs/FIXERS_V2.md): unpinned fixers the player can hold through a rotation, days a dropped fixer stays away,
         days a newcomer is marked "new", specialties the pool always keeps -->
    <maxHeld>2</maxHeld>
    <!-- Silver per held fixer, paid at each rotation (the hold lapses if you cannot pay) -->
    <holdCost>100</holdCost>
    <!-- Breaking ties during a running contract: the fixer takes this much cyberdata, or adds Heat if there is none -->
    <breakContractCyberdata>6</breakContractCyberdata>
    <breakContractHeat>6</breakContractHeat>
    <breakBanDays>30</breakBanDays>
    <newcomerDays>2</newcomerDays>
    <minSpecialties>2</minSpecialties>
    <pinnedReputation>45</pinnedReputation>
    <traitRevealReputation>20</traitRevealReputation>

    <!-- Contacting a fixer: cost in silver and how long the channel stays open -->
    <callCost>50~150</callCost>
    <channelHours>24</channelHours>

    <!-- Prices: Greedy multiplier; discount from reputation (at 100), Cleaner bonus, total cap -->
    <greedyPriceFactor>1.25</greedyPriceFactor>
    <!-- Royalty: chance a newcomer is an imperial client (only at peace with the Empire); their contracts pay this share
         of the silver and one royal favor per this much of the full reward, up to the maximum -->
    <imperialChance>0.2</imperialChance>
    <imperialSilverFactor>0.6</imperialSilverFactor>
    <imperialSilverPerFavor>150</imperialSilverPerFavor>
    <imperialMaxFavor>6</imperialMaxFavor>
    <!-- Traits. Weights by specialty, in the order Greedy, Reliable, Rat, Paranoid, Gambler, Loyal, Veteran, Collector, Hothead -->
    <traitWeightsBroker><li>2</li><li>2</li><li>1</li><li>2</li><li>2</li><li>2</li><li>1</li><li>0</li><li>2</li></traitWeightsBroker>
    <traitWeightsCleaner><li>1</li><li>2</li><li>1</li><li>2</li><li>1</li><li>2</li><li>3</li><li>0</li><li>1</li></traitWeightsCleaner>
    <traitWeightsFence><li>2</li><li>1</li><li>2</li><li>1</li><li>1</li><li>1</li><li>1</li><li>3</li><li>1</li></traitWeightsFence>
    <!-- Greedy: more goods in the shop. Reliable: rewards x0.9, but a failure is forgiven by half. Rat: everything x0.8 -->
    <greedyExtraStock>2</greedyExtraStock>
    <reliableRewardFactor>0.9</reliableRewardFactor>
    <ratPriceFactor>0.8</ratPriceFactor>
    <!-- Paranoid: revenge raids against the colony come weaker. Gambler: the reward is rolled on completion -->
    <paranoidRaidFactor>0.75</paranoidRaidFactor>
    <gamblerRewardFactor>0.5~1.8</gamblerRewardFactor>
    <!-- Loyal: reputation grows faster, extra discount once pinned. Veteran: better scrub, dearer call -->
    <loyalReputationFactor>2</loyalReputationFactor>
    <loyalPinnedDiscount>0.1</loyalPinnedDiscount>
    <veteranScrubFactor>1.2</veteranScrubFactor>
    <veteranCallFactor>1.3</veteranCallFactor>
    <!-- Collector: always rare goods, fewer ordinary ones. Hothead: short contracts, bigger pay, Heat on failure -->
    <collectorStockPenalty>2</collectorStockPenalty>
    <hotheadDurationFactor>0.6</hotheadDurationFactor>
    <hotheadRewardFactor>1.4</hotheadRewardFactor>
    <hotheadFailHeat>10</hotheadFailHeat>
    <maxReputationDiscount>0.5</maxReputationDiscount>
    <cleanerDiscount>0.25</cleanerDiscount>
    <maxDiscount>0.75</maxDiscount>

    <!-- Heat removed per data item before discounts -->
    <heatPerCyberdata>5</heatPerCyberdata>
    <!-- Rotate the fixer pool now (pinned, held and fixers with a running contract stay), for this much cyberdata -->
    <rotateNowCost>8</rotateNowCost>
    <!-- Black market goods cost this much more than the fixer's own stock -->
    <blackMarketMarkup>2.5</blackMarketMarkup>
    <heatPerAdvancedCyberdata>15</heatPerAdvancedCyberdata>
    <!-- Instant scrub (Cleaner only) gets dearer as the trace grows: factor by Heat level (Shadow, Noticed, Tracked, Target, Red zone).
         5 Heat per cyberdata x 0.6/0.5/0.4/0.3/0.3 = 3/2.5/2/1.5/1.5, Red zone price x2 below = 0.75 (advanced x3). Reputation does not change it. -->
    <scrubFactorByLevel>
      <li>0.6</li>
      <li>0.5</li>
      <li>0.4</li>
      <li>0.3</li>
      <li>0.3</li>
    </scrubFactorByLevel>
    <!-- One instant scrub takes at most this much Heat (Red zone: less), then the same Cleaner waits this many days -->
    <cleanerScrubMaxHeat>25</cleanerScrubMaxHeat>
    <cleanerScrubMaxHeatRedZone>15</cleanerScrubMaxHeatRedZone>
    <cleanerScrubCooldownDays>3</cleanerScrubCooldownDays>
    <redZoneScrubPriceFactor>2</redZoneScrubPriceFactor>
    <!-- Slow cooling at any fixer: cyberdata for extra cooling per day over a few days, one deal at a time; Red zone price x2 except at a Cleaner -->
    <coolingCost>5</coolingCost>
    <coolingPerDay>4</coolingPerDay>
    <coolingDays>3</coolingDays>
    <redZoneCoolingPriceFactor>2</redZoneCoolingPriceFactor>
    <!-- "Street" contracts: the only work fixers offer and accept in the Red zone -->
    <streetContracts>
      <li>DataDelivery</li>
      <li>Surveillance</li>
      <li>LayLow</li>
      <li>Rookie</li>
      <li>CleanLab</li>
    </streetContracts>

    <!-- Rat trait: chance to leak after a deal, and the Heat it adds -->
    <ratLeakChance>0.1</ratLeakChance>
    <ratLeakHeat>10</ratLeakHeat>

    <!-- Reputation gained per deal -->
    <reputationPerCall>2</reputationPerCall>
    <reputationPerScrub>5</reputationPerScrub>
    <reputationPerPurchase>5</reputationPerPurchase>

    <!-- Shop (Fence fixers): markup over market value, items per fixer, what can show up -->
    <shopMarkup>1.3</shopMarkup>
    <shopStockSize>4</shopStockSize>
    <shopItems>
      <li>USH_Cyberlink</li>
      <li>USH_JammerKit</li>
      <li>USH_OptimizationModule</li>
      <li>USH_RemoteAccessPort</li>
      <li>USH_ExecDataCase</li>
      <li>USH_ICEBreaker</li>
      <li>USH_BrokenExecData</li>
      <li>USH_AdvancedCyberdata</li>
      <li>NR_AIFragment</li>
    </shopItems>
    <!-- Cyberdata in packs of this many, always in stock (0 = off) -->
    <cyberdataBundle>10</cyberdataBundle>
    <!-- Extra goods only from pinned fixers -->
    <pinnedShopItems>
      <li>NR_AICoreModule</li>
    </pinnedShopItems>

    <!-- Contracts: offers per fixer, deadline in days, reputation on success / loss on failure,
         days a fixer stays silent after a failure, chance that a Rat leaks after a failure -->
    <offersPerFixer>1~2</offersPerFixer>
    <contractDays>3~7</contractDays>
    <contractReputation>10</contractReputation>
    <failReputationLoss>7</failReputationLoss>
    <failSilentDays>3</failSilentDays>
    <ratFailLeakChance>0.5</ratFailLeakChance>

    <!-- Data delivery: items wanted, silver per item, how many items one advanced cyberdata counts as,
         Broker reward multiplier -->
    <dataDeliveryGoal>4~10</dataDeliveryGoal>
    <dataDeliveryRewardPerItem>35</dataDeliveryRewardPerItem>
    <advancedCyberdataWorth>3</advancedCyberdataWorth>
    <!-- A fence buys a fresh AI fragment: min price, rising to the max with reputation (a wild AI sold in a dive pays the best of these) -->
    <shardBuyMin>800</shardBuyMin>
    <shardBuyMax>1000</shardBuyMax>
    <brokerDataBonus>1.43</brokerDataBonus>

    <!-- System tap: hacks wanted, silver per hack -->
    <systemTapGoal>2~5</systemTapGoal>
    <systemTapRewardPerHack>70</systemTapRewardPerHack>

    <!-- Surveillance: netrunner-hours in a cyberpod, silver per hour. Lay low: offered at this Heat or more, bring it down by this much.
         Rookie: dives without a failure by a colonist with Intellectual up to this. AI order: one AI fragment. Clean lab: chips of one mood. -->
    <surveillanceHours>12~30</surveillanceHours>
    <surveillanceRewardPerHour>15</surveillanceRewardPerHour>
    <layLowMinHeat>25</layLowMinHeat>
    <layLowDrop>15~30</layLowDrop>
    <layLowRewardPerHeat>8</layLowRewardPerHeat>
    <rookieMaxSkill>6</rookieMaxSkill>
    <rookieDives>2</rookieDives>
    <rookieReward>250</rookieReward>
    <aiOrderReward>400</aiOrderReward>
    <cleanLabChips>1~2</cleanLabChips>
    <cleanLabRewardPerChip>180</cleanLabRewardPerChip>

    <!-- Quiet run: hacks wanted while Heat stays at Tracked or lower, silver per hack -->
    <quietRunGoal>2~4</quietRunGoal>
    <quietRunRewardPerHack>130</quietRunRewardPerHack>
  </Netrun.FixerSettingsDef>

  <!-- Fixer handles -->
  <RulePackDef>
    <defName>NR_NamerFixer</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[adj] [noun]</li>
        <li>r_name->[noun]</li>
        <li>r_name->[adj][noun]</li>

        <li>adj->Silent</li>
        <li>adj->Rogue</li>
        <li>adj->Cold</li>
        <li>adj->Black</li>
        <li>adj->Chrome</li>
        <li>adj->Neon</li>
        <li>adj->Dead</li>
        <li>adj->Iron</li>
        <li>adj->Velvet</li>
        <li>adj->Static</li>
        <li>adj->Lucky</li>
        <li>adj->Grey</li>
        <li>adj->Hollow</li>
        <li>adj->Quiet</li>
        <li>adj->Burnt</li>
        <li>adj->Glass</li>
        <li>adj->Pale</li>
        <li>adj->Red</li>

        <li>noun->Wire</li>
        <li>noun->Byte</li>
        <li>noun->Ghost</li>
        <li>noun->Fox</li>
        <li>noun->Saint</li>
        <li>noun->Jack</li>
        <li>noun->Moth</li>
        <li>noun->Raven</li>
        <li>noun->Dealer</li>
        <li>noun->Proxy</li>
        <li>noun->Echo</li>
        <li>noun->Vex</li>
        <li>noun->Rook</li>
        <li>noun->Kestrel</li>
        <li>noun->Cipher</li>
        <li>noun->Widow</li>
        <li>noun->Patch</li>
        <li>noun->Static</li>
        <li>noun->Halo</li>
        <li>noun->Needle</li>
        <li>noun->Magpie</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

</Defs>
