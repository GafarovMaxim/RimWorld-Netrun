<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- All fixer balance numbers. Tweak here, no code changes needed. -->
  <Netrun.FixerSettingsDef>
    <defName>NR_Fixers</defName>

    <!-- Pool: size, rotation period in days, reputation that pins a fixer for good,
         reputation that reveals the fixer's trait -->
    <poolSize>4</poolSize>
    <rotationDays>7~10</rotationDays>
    <!-- Fixers v2 (docs/FIXERS_V2.md): unpinned fixers the player can hold through a rotation, days a dropped fixer stays away,
         days a newcomer is marked "new", specialties the pool always keeps -->
    <maxHeld>2</maxHeld>
    <!-- Silver per held fixer, paid at each rotation (the hold lapses if you cannot pay) -->
    <holdCost>100</holdCost>
    <breakBanDays>30</breakBanDays>
    <newcomerDays>2</newcomerDays>
    <minSpecialties>2</minSpecialties>
    <pinnedReputation>45</pinnedReputation>
    <traitRevealReputation>20</traitRevealReputation>

    <!-- Contacting a fixer: cost in silver and how long the channel stays open -->
    <callCost>50~150</callCost>
    <channelHours>24</channelHours>

    <!-- Prices: Greedy multiplier; discount from reputation (at 100), Cleaner bonus, total cap -->
    <greedyPriceFactor>1.25</greedyPriceFactor>
    <maxReputationDiscount>0.5</maxReputationDiscount>
    <cleanerDiscount>0.25</cleanerDiscount>
    <maxDiscount>0.75</maxDiscount>

    <!-- Heat removed per data item before discounts -->
    <heatPerCyberdata>5</heatPerCyberdata>
    <heatPerAdvancedCyberdata>15</heatPerAdvancedCyberdata>
    <!-- Scrub gets dearer as the trace grows: factor by Heat level (Shadow, Noticed, Tracked, Target, Red zone). 5 Heat per cyberdata x 0.6/0.6/0.4/0.3/0.2 = 3/3/2/1.5/1 (advanced x3). -->
    <scrubFactorByLevel>
      <li>0.6</li>
      <li>0.6</li>
      <li>0.4</li>
      <li>0.3</li>
      <li>0.2</li>
    </scrubFactorByLevel>

    <!-- Rat trait: chance to leak after a deal, and the Heat it adds -->
    <ratLeakChance>0.1</ratLeakChance>
    <ratLeakHeat>10</ratLeakHeat>

    <!-- Reputation gained per deal -->
    <reputationPerCall>2</reputationPerCall>
    <reputationPerScrub>5</reputationPerScrub>
    <reputationPerPurchase>5</reputationPerPurchase>

    <!-- Shop (Fence fixers): markup over market value, items per fixer, what can show up -->
    <shopMarkup>1.3</shopMarkup>
    <shopStockSize>4</shopStockSize>
    <shopItems>
      <li>USH_Cyberlink</li>
      <li>USH_JammerKit</li>
      <li>USH_OptimizationModule</li>
      <li>USH_RemoteAccessPort</li>
      <li>USH_ExecDataCase</li>
      <li>USH_ICEBreaker</li>
      <li>USH_BrokenExecData</li>
      <li>USH_AdvancedCyberdata</li>
      <li>NR_AIFragment</li>
    </shopItems>
    <!-- Extra goods only from pinned fixers -->
    <pinnedShopItems>
      <li>NR_AICoreModule</li>
    </pinnedShopItems>

    <!-- Contracts: offers per fixer, deadline in days, reputation on success / loss on failure,
         days a fixer stays silent after a failure, chance that a Rat leaks after a failure -->
    <offersPerFixer>1~2</offersPerFixer>
    <contractDays>3~7</contractDays>
    <contractReputation>10</contractReputation>
    <failReputationLoss>7</failReputationLoss>
    <failSilentDays>3</failSilentDays>
    <ratFailLeakChance>0.5</ratFailLeakChance>

    <!-- Data delivery: items wanted, silver per item, how many items one advanced cyberdata counts as,
         Broker reward multiplier -->
    <dataDeliveryGoal>4~10</dataDeliveryGoal>
    <dataDeliveryRewardPerItem>60</dataDeliveryRewardPerItem>
    <advancedCyberdataWorth>3</advancedCyberdataWorth>
    <brokerDataBonus>1.5</brokerDataBonus>

    <!-- System tap: hacks wanted, silver per hack -->
    <systemTapGoal>2~5</systemTapGoal>
    <systemTapRewardPerHack>120</systemTapRewardPerHack>

    <!-- Quiet run: hacks wanted while Heat stays at Tracked or lower, silver per hack -->
    <quietRunGoal>2~4</quietRunGoal>
    <quietRunRewardPerHack>220</quietRunRewardPerHack>
  </Netrun.FixerSettingsDef>

  <!-- Fixer handles -->
