<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Heat and cyberpod balance numbers. Tweak here, no code changes needed. -->
  <Netrun.HeatSettingsDef>
    <defName>NR_Heat</defName>

    <!-- Heat from a completed hack: target defence / defencePerHeat, kept within hackHeat -->
    <defencePerHeat>1000</defencePerHeat>
    <hackHeat>2~15</hackHeat>
    <!-- Royalty permit "imperial trace scrub" -->
    <imperialScrubAmount>20</imperialScrubAmount>

    <!-- Hacker stealth: Heat is multiplied by baseStealth / stealth, kept within stealthFactor -->
    <baseStealth>100</baseStealth>
    <stealthFactor>0.25~2</stealthFactor>

    <!-- Hacking from a Hacking Expansion cyberpod: Heat multiplier, stealth multiplier
         (also makes Hacking Expansion ICE outcomes rarer), chance of an extra cyberdata per hack -->
    <cyberpodHeatFactor>0.6</cyberpodHeatFactor>
    <cyberpodStealthFactor>1.3</cyberpodStealthFactor>
    <cyberpodBonusDataChance>0.25</cyberpodBonusDataChance>

    <!-- Heat per item ripped with Hacking Expansion's data ripping -->
    <heatPerRippedItem>1</heatPerRippedItem>

    <!-- Heat from the "trace lock" ICE outcome -->
    <traceLockHeat>8</traceLockHeat>
    <!-- Passive cooling a day = decayBase + decayPerHeat x Heat (times the cooling setting), at any level -->
    <decayBase>3</decayBase>
    <decayPerHeat>0.04</decayPerHeat>
    <!-- Vanilla enemy raids on a player home get more points at these levels (not our mercenaries) -->
    <raidPointsTracked>1.1</raidPointsTracked>
    <raidPointsTarget>1.2</raidPointsTarget>
    <raidPointsRedZone>1.25</raidPointsRedZone>
    <!-- Network isolation held this many hours without a break multiplies cooling -->
    <isolationCoolingHours>12</isolationCoolingHours>
    <isolationCoolingFactor>2</isolationCoolingFactor>
    <!-- Red zone: a dive's entry costs this much more cyberdata -->
    <redZoneDiveExtraCost>1</redZoneDiveExtraCost>

    <!-- An AI in a AI coprocessor linked to the cyberpod: Heat factor (Ghost hides better),
         extra cyberdata chance (Data Hunter finds more), Netsick factor (Doc and Warden protect the diver) -->
    <coprocessorHeatFactor>0.8</coprocessorHeatFactor>
    <coprocessorGhostHeatFactor>0.5</coprocessorGhostHeatFactor>
    <coprocessorBonusDataChance>0.1</coprocessorBonusDataChance>
    <coprocessorDataHunterBonusDataChance>0.3</coprocessorDataHunterBonusDataChance>
    <coprocessorNetsickFactor>0.75</coprocessorNetsickFactor>
    <coprocessorDocNetsickFactor>0.4</coprocessorDocNetsickFactor>
  </Netrun.HeatSettingsDef>

  <!-- ICE outcome added to Hacking Expansion's ICE hacksets (see Patches/HackingExpansion.xml). -->
  <USH_HE.HackingOutcomeDef ParentName="USH_HackingOutcomeBase">
    <defName>NR_TraceLock</defName>
    <label>trace lock</label>
    <workerClass>Netrun.HackingOutcomeWorker_TraceLock</workerClass>
    <worksWithPod>true</worksWithPod>
  </USH_HE.HackingOutcomeDef>

</Defs>
