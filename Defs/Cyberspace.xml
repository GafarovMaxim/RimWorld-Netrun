<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Architect tab for the mod's buildings: AI server, server rack, AI coprocessor -->
  <DesignationCategoryDef>
    <defName>NR_Cyberspace</defName>
    <label>cyberspace</label>
    <description>Cyberpods, coprocessors, data servers, AI servers and server racks.</description>
    <order>245</order>
    <specialDesignatorClasses>
      <li>Designator_Cancel</li>
      <li>Designator_Deconstruct</li>
    </specialDesignatorClasses>
  </DesignationCategoryDef>

  <!-- Gateway and dive numbers (docs/CYBERSPACE.md); field meanings in CyberspaceSettingsDef -->
  <Netrun.CyberspaceSettingsDef>
    <defName>NR_Cyberspace</defName>
    <nodeCount>4~6</nodeCount>
    <hiddenNodes>1</hiddenNodes>
    <refreshDays>5</refreshDays>
    <searchCost>5</searchCost>
    <programCost>1</programCost>
    <programSlots>2</programSlots>
    <diveBaseCost>1</diveBaseCost>
    <coprocessorDiscount>1</coprocessorDiscount>
    <passengerDiscount>1</passengerDiscount>
    <maxTurns>8</maxTurns>
    <hackBase>0.35</hackBase>
    <hackPerSkill>0.03</hackPerSkill>
    <hackPerStrength>0.06</hackPerStrength>
    <swordBonus>0.3</swordBonus>
    <tracePerAction>1</tracePerAction>
    <stealthTraceFactor>0.5</stealthTraceFactor>
    <iceAttackChance>0.6</iceAttackChance>
    <decoyChance>0.5</decoyChance>
    <retreatLootLoss>0.5</retreatLootLoss>
    <!-- About 0.1 Netsick per dive in total (with pod time and ICE hits); recovery is 0.04/day (Netsick.xml):
         a dive every 2-3 days stays flat, ten daily dives reach "strong" -->
    <netsickPerDive>0.06</netsickPerDive>
    <netsickPerIceHit>0.04</netsickPerIceHit>
    <!-- A failed dive (not a retreat): a few small burns from the neural feedback -->
    <failBurns>2~3</failBurns>
    <failBurnDamage>1.5~3.5</failBurnDamage>
    <successXp>400</successXp>
    <!-- Waking up and leaving a cyberpod, ticks (Hacking Expansion: 5000 = 2 hours) -->
    <podWakeUpTicks>2500</podWakeUpTicks>
    <!-- Main files pay the dive cost back times this: defense up to 2, up to 4, Black ICE. Plus a chance of something special on a clean exit. -->
    <rewardMultLow>1.5</rewardMultLow>
    <rewardMultMid>2</rewardMultMid>
    <rewardMultBlackIce>3</rewardMultBlackIce>
    <specialItemChance>0.1</specialItemChance>
    <specialItemChanceBlackIce>0.25</specialItemChanceBlackIce>
    <!-- Special finds by weight (docs/PHASE5_REWARDS.md) -->
    <findFragment>30</findFragment>
    <findResearch>20</findResearch>
    <findFixerService>15</findFixerService>
    <findGroupFavor>15</findGroupFavor>
    <findCelebrityChip>12</findCelebrityChip>
    <findDaemon>5</findDaemon>
    <findCoreModule>3</findCoreModule>
    <researchReward>600</researchReward>
    <fixerServiceReputation>8</fixerServiceReputation>
    <freeScrubHeat>15</freeScrubHeat>
    <groupFavorForAllies>3</groupFavorForAllies>
    <alliesCooldownDays>15</alliesCooldownDays>
    <!-- Boss node: corporate core -->
    <bossIntervalDays>20</bossIntervalDays>
    <bossLifetimeDays>3</bossLifetimeDays>
    <bossIceStrength>8</bossIceStrength>
    <bossRewardMult>6</bossRewardMult>
    <bossCoreModuleChance>0.5</bossCoreModuleChance>
    <!-- Cyberspace events (docs/PHASE5_CYBEREVENTS.md) -->
    <hunterChance>0.35</hunterChance>
    <hunterFromTurn>3</hunterFromTurn>
    <hunterStrength>6</hunterStrength>
    <hunterAttackChance>0.4</hunterAttackChance>
    <hunterEscapeHeat>10</hunterEscapeHeat>
    <rivalChance>0.15</rivalChance>
    <rivalTurns>5</rivalTurns>
    <honeypotChance>0.12</honeypotChance>
    <honeypotTrace>8</honeypotTrace>
    <honeypotRewardShare>0.5</honeypotRewardShare>
    <honeypotShownReward>1.5</honeypotShownReward>
    <stormChance>0.2</stormChance>
    <stormDays>1~2</stormDays>
    <stormRewardMult>1.5</stormRewardMult>
    <wildAIChance>0.25</wildAIChance>
    <wildAITameTrace>5</wildAITameTrace>
    <wildAIEraseAdvanced>3</wildAIEraseAdvanced>
    <wildAISellSilver>500</wildAISellSilver>
    <wildAISellHeat>10</wildAISellHeat>
  </Netrun.CyberspaceSettingsDef>

</Defs>
