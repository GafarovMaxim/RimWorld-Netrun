<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Architect tab for the mod's buildings: AI server, server rack, AI coprocessor -->
  <DesignationCategoryDef>
    <defName>NR_Cyberspace</defName>
    <label>cyberspace</label>
    <description>Cyberpods, coprocessors, data servers, AI servers and server racks.</description>
    <order>245</order>
    <specialDesignatorClasses>
      <li>Designator_Cancel</li>
      <li>Designator_Deconstruct</li>
    </specialDesignatorClasses>
  </DesignationCategoryDef>

  <!-- Gateway and dive numbers (docs/CYBERSPACE.md); field meanings in CyberspaceSettingsDef -->
  <Netrun.CyberspaceSettingsDef>
    <defName>NR_Cyberspace</defName>
    <nodeCount>4~6</nodeCount>
    <hiddenNodes>1</hiddenNodes>
    <refreshDays>5</refreshDays>
    <programCost>1</programCost>
    <programSlots>2</programSlots>
    <diveBaseCost>1</diveBaseCost>
    <coprocessorDiscount>1</coprocessorDiscount>
    <passengerDiscount>1</passengerDiscount>
    <maxTurns>8</maxTurns>
    <hackBase>0.30</hackBase>
    <hackPerSkill>0.035</hackPerSkill>
    <hackPerStrength>0.065</hackPerStrength>
    <!-- Sum of all hack bonuses (programs, daemons, traits, AI, HE, recordings) is capped (docs/DIVE_BALANCE.md) -->
    <hackBonusCap>0.30</hackBonusCap>
    <!-- Node alert: every failed gate hack raises it; at the threshold an ICE patrol wakes up and may strike each
         node turn, throwing the runner out with half the haul. Defense this low or lower has no alert. -->
    <alertThreshold>3</alertThreshold>
    <alertPatrolChance>0.15</alertPatrolChance>
    <alertFreeDefense>1</alertFreeDefense>
    <alertPatrolKeepShare>0.5</alertPatrolKeepShare>
    <swordBonus>0.3</swordBonus>
    <tracePerAction>1</tracePerAction>
    <stealthTraceFactor>0.5</stealthTraceFactor>
    <iceAttackChance>0.6</iceAttackChance>
    <decoyChance>0.5</decoyChance>
    <retreatLootLoss>0.5</retreatLootLoss>
    <!-- About 0.1 Netsick per dive in total (with pod time and ICE hits); recovery is 0.04/day (Netsick.xml):
         a dive every 2-3 days stays flat, ten daily dives reach "strong" -->
    <netsickPerDive>0.02</netsickPerDive>
    <netsickPerIceHit>0.03</netsickPerIceHit>
    <!-- A failed dive (not a retreat): a few small burns from the neural feedback -->
    <failBurns>2~3</failBurns>
    <failBurnDamage>1.5~3.5</failBurnDamage>
    <!-- Branches (docs/DIVE_BRANCHING.md): medium nodes fork once, large ones and the corporate core twice.
         The hard branch carries Black ICE; the easy one a hidden passage (+10% to the files). -->
    <branchHardTrace>4</branchHardTrace>
    <branchEasyTrace>1</branchEasyTrace>
    <branchPassageBonus>0.1</branchPassageBonus>
    <branchExtraTurns>3</branchExtraTurns>
    <successXp>400</successXp>
    <!-- Chance per Black ICE hit that the runner's cyberlink burns out and is gone (1-5% was asked) -->
    <blackIceCyberlinkLoss>0.03</blackIceCyberlinkLoss>
    <!-- Living cyberspace: a headline every few days (scaled by the cyberspace event setting), shown for newsKeepDays.
         Data glut: dive cyberdata x1.3 for 2 days. Quiet net: dive trace x0.7 for a day. Corp lockdown after the core falls: corp nodes +1 defense for a week. -->
    <newsIntervalDays>2~4</newsIntervalDays>
    <newsKeepDays>3</newsKeepDays>
    <newsGlutDays>2</newsGlutDays>
    <newsGlutLoot>1.3</newsGlutLoot>
    <newsQuietDays>1</newsQuietDays>
    <newsQuietTrace>0.7</newsQuietTrace>
    <newsLockdownDays>7</newsLockdownDays>
    <!-- What a dive leaves on the runner. Flow: a clean exit without ICE hits (a day, +5% hack). Memory: on success, XP to a random skill.
         Migraine: the dive lasted this many turns. Phantom signals: at this Netsick, with this chance. Burned link: failed Black ICE dive after a hit (-10% hack, 3 days). -->
    <effectMemoryChance>0.25</effectMemoryChance>
    <effectMemoryXp>1500</effectMemoryXp>
    <effectMigraineTurns>9</effectMigraineTurns>
    <effectPhantomNetsick>0.6</effectPhantomNetsick>
    <effectPhantomChance>0.3</effectPhantomChance>
    <effectBurnedLinkChance>0.25</effectBurnedLinkChance>
    <effectFlowHackBonus>0.05</effectFlowHackBonus>
    <effectBurnedHackPenalty>0.1</effectBurnedHackPenalty>
    <!-- Waking up and leaving a cyberpod, ticks (Hacking Expansion: 5000 = 2 hours) -->
    <podWakeUpTicks>2500</podWakeUpTicks>
    <!-- Main files by node tier (fixed ranges, docs/BALANCE_PLAN.md section 2): defense up to 2, medium (easy path / hard path), Black ICE, the core.
         Caches 1, the forgotten cache 2-4. Corp advanced cyberdata only on the hard path (the core 2-3). Dark exchange silver. Plus a chance of something special on a clean exit. -->
    <rewardLow>2~3</rewardLow>
    <rewardMid>3~5</rewardMid>
    <rewardMidHard>4~6</rewardMidHard>
    <rewardBlackIce>5~8</rewardBlackIce>
    <rewardBoss>10~14</rewardBoss>
    <cacheReward>1~1</cacheReward>
    <forgottenCacheReward>2~4</forgottenCacheReward>
    <advancedCorpHard>1~1</advancedCorpHard>
    <advancedBoss>2~3</advancedBoss>
    <!-- Black ICE nodes other than corp vaults: +1 advanced with the files. The memory unit: 1-2 advanced unless it holds a fragment or a module. -->
    <advancedBlackIce>1~1</advancedBlackIce>
    <memoryAdvanced>1~2</memoryAdvanced>
    <!-- All reward multipliers on one dive (storm, guarded hub, lure, mirror, news glut, Orbit, hidden passages) stack to at most this; the core is exempt. -->
    <rewardMultCap>2</rewardMultCap>
    <exchangeSilver>120~250</exchangeSilver>
    <specialItemChance>0.1</specialItemChance>
    <specialItemChanceBlackIce>0.25</specialItemChanceBlackIce>
    <!-- Special finds by weight (docs/PHASE5_REWARDS.md) -->
    <findFragment>15</findFragment>
    <!-- AI fragment in a node memory unit (CONCEPTS_10, section 2: halved) -->
    <memoryFragmentAbandoned>0.15</memoryFragmentAbandoned>
    <memoryFragmentOther>0.05</memoryFragmentOther>
    <findResearch>20</findResearch>
    <findFixerService>15</findFixerService>
    <findGroupFavor>15</findGroupFavor>
    <findCelebrityChip>12</findCelebrityChip>
    <findDaemon>5</findDaemon>
    <findCoreModule>3</findCoreModule>
    <researchReward>600</researchReward>
    <fixerServiceReputation>8</fixerServiceReputation>
    <freeScrubHeat>15</freeScrubHeat>
    <groupFavorForAllies>3</groupFavorForAllies>
    <alliesCooldownDays>15</alliesCooldownDays>
    <!-- Boss node: corporate core -->
    <bossIntervalDays>20</bossIntervalDays>
    <bossLifetimeDays>3</bossLifetimeDays>
    <bossIceStrength>8</bossIceStrength>
    <bossCoreModuleChance>0.5</bossCoreModuleChance>
    <!-- Cyberspace events (docs/PHASE5_CYBEREVENTS.md) -->
    <hunterChance>0.35</hunterChance>
    <hunterFromTurn>3</hunterFromTurn>
    <hunterStrength>6</hunterStrength>
    <hunterAttackChance>0.4</hunterAttackChance>
    <hunterEscapeHeat>10</hunterEscapeHeat>
    <rivalChance>0.15</rivalChance>
    <rivalTurns>5</rivalTurns>
    <honeypotChance>0.12</honeypotChance>
    <honeypotTrace>8</honeypotTrace>
    <honeypotRewardShare>0.5</honeypotRewardShare>
    <honeypotShownReward>1.5</honeypotShownReward>
    <stormChance>0.2</stormChance>
    <stormDays>1~2</stormDays>
    <stormRewardMult>1.5</stormRewardMult>
    <wildAIChance>0.25</wildAIChance>
    <wildAITameTrace>5</wildAITameTrace>
    <wildAIEraseAdvanced>3</wildAIEraseAdvanced>
    <wildAISellSilver>500</wildAISellSilver>
    <wildAISellHeat>10</wildAISellHeat>
  </Netrun.CyberspaceSettingsDef>

</Defs>
