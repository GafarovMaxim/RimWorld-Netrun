<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ChemicalDef>
    <defName>BI_BrainDanceChemical</defName>
    <label>braindance</label>
    <addictionHediff>BI_BrainDanceAddiction</addictionHediff>
    <toleranceHediff>BI_BrainDanceTolerance</toleranceHediff>
    <onGeneratedAddictedToleranceChance>0.8</onGeneratedAddictedToleranceChance>
  </ChemicalDef>

  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_BI_BrainDance</defName>
    <needClass>Need_Chemical</needClass>
    <label>braindance</label>
    <description>Because of a braindance addiction, this person needs to consume recorded experiences to avoid withdrawal symptoms.</description>
    <listPriority>55</listPriority>
  </NeedDef>

  <HediffDef ParentName="DrugToleranceBase">
    <defName>BI_BrainDanceTolerance</defName>
    <label>braindance tolerance</label>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-0.02</severityPerDay></li>
      <li Class="HediffCompProperties_DrugEffectFactor"><chemical>BI_BrainDanceChemical</chemical></li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="AddictionBase">
    <defName>BI_BrainDanceAddiction</defName>
    <hediffClass>Hediff_Addiction</hediffClass>
    <label>braindance addiction</label>
    <causesNeed>Chemical_BI_BrainDance</causesNeed>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay"><severityPerDay>-0.04</severityPerDay></li>
    </comps>
    <stages>
      <li />
      <li>
        <label>withdrawal</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
        </capMods>
        <mentalStateGivers>
          <li><mentalState>Binging_DrugMajor</mentalState><mtbDays>35</mtbDays></li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>BI_BrainDanceWithdrawal</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>BI_BrainDanceAddiction</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><visible>false</visible></li>
      <li>
        <label>braindance withdrawal</label>
        <description>Ordinary reality feels painfully flat without the recorded experience.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
