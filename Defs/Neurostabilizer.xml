<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Neurostabilizer: eases Netsick and holds the withdrawal off: none for at least 4 days. Mild addiction, like smokeleaf. -->

  <ThingDef ParentName="MakeableDrugBase">
    <defName>NR_Neurostabilizer</defName>
    <label>neurostabilizer</label>
    <description>A blister of neutroamine capsules laced with a cyberdata-tuned neural buffer. It quiets the itch for the net: the dependency eases a little, for two days the user does not feel cut off and does not break for a pod, and the withdrawal does not return for at least 4 days.\n\nIt is mildly habit-forming, about like smokeleaf: taken often, it becomes a need of its own.</description>
    <descriptionHyperlinks>
      <HediffDef>NR_NeurostabilizerHigh</HediffDef>
      <HediffDef>NR_NeurostabilizerAddiction</HediffDef>
      <HediffDef>NR_Netsick</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/Drug/NR_Neurostabilizer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <stackLimit>25</stackLimit>
    <statBases>
      <WorkToMake>700</WorkToMake>
      <MarketValue>45</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <techLevel>Spacer</techLevel>
    <costList>
      <Neutroamine>1</Neutroamine>
      <USH_Cyberdata>2</USH_Cyberdata>
    </costList>
    <recipeMaker>
      <researchPrerequisite>NR_Res_Neurorecording</researchPrerequisite>
      <recipeUsers>
        <li>DrugLab</li>
      </recipeUsers>
      <soundWorking>Recipe_Drug</soundWorking>
      <displayPriority>1600</displayPriority>
    </recipeMaker>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <foodType>Processed</foodType>
      <baseIngestTicks>100</baseIngestTicks>
      <ingestSound>Ingest_Pill</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestHoldOffsetStanding>
        <northDefault>
          <offset>(0.18,0,0)</offset>
        </northDefault>
      </ingestHoldOffsetStanding>
      <ingestCommandString>Take {0}</ingestCommandString>
      <ingestReportString>Taking {0}.</ingestReportString>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <chairSearchRadius>0</chairSearchRadius>
      <outcomeDoers>
        <li Class="Netrun.IngestionOutcomeDoer_ReduceNetsick">
          <amount>0.15</amount>
          <postponeDays>4</postponeDays>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>NR_NeurostabilizerHigh</hediffDef>
          <severity>1</severity>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>NR_NeurostabilizerTolerance</hediffDef>
          <severity>0.030</severity>
          <divideByBodySize>true</divideByBodySize>
          <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>NR_Neurostabilizer</chemical>
        <addictiveness>0.020</addictiveness>
        <minToleranceToAddict>0.15</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.06</existingAddictionSeverityOffset>
        <needLevelOffset>1</needLevelOffset>
        <listOrder>1010</listOrder>
      </li>
    </comps>
  </ThingDef>

  <HediffDef>
    <defName>NR_NeurostabilizerHigh</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>neurostabilized</label>
    <description>A neural buffer keeps the itch for the net quiet. While it lasts, Netsick causes no withdrawal and no net craving.</description>
    <defaultLabelColor>(0.4, 0.9, 1)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
  </HediffDef>

  <ChemicalDef>
    <defName>NR_Neurostabilizer</defName>
    <label>neurostabilizer</label>
    <addictionHediff>NR_NeurostabilizerAddiction</addictionHediff>
    <toleranceHediff>NR_NeurostabilizerTolerance</toleranceHediff>
    <onGeneratedAddictedToleranceChance>0.8</onGeneratedAddictedToleranceChance>
  </ChemicalDef>

  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_NR_Neurostabilizer</defName>
    <needClass>Need_Chemical</needClass>
    <label>neurostabilizer</label>
    <description>Because of a neurostabilizer dependence, this person needs regular doses to avoid withdrawal symptoms.</description>
    <listPriority>25</listPriority>
  </NeedDef>

  <HediffDef ParentName="DrugToleranceBase">
    <defName>NR_NeurostabilizerTolerance</defName>
    <label>neurostabilizer tolerance</label>
    <description>A built-up tolerance to the neurostabilizer. The more severe it is, the less a dose does.</description>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.015</severityPerDay>
      </li>
      <li Class="HediffCompProperties_DrugEffectFactor">
        <chemical>NR_Neurostabilizer</chemical>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="AddictionBase">
    <defName>NR_NeurostabilizerAddiction</defName>
    <hediffClass>Hediff_Addiction</hediffClass>
    <label>neurostabilizer dependence</label>
    <description>The brain got used to the neural buffer and now itches without it.\n\nWithout regular doses, withdrawal symptoms will begin. Extended abstinence will slowly resolve the dependence.</description>
    <chemicalNeed>Chemical_NR_Neurostabilizer</chemicalNeed>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.0333</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li />
      <li>
        <label>withdrawal</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>Binging_DrugMajor</mentalState>
            <mtbDays>50</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>NR_NeurostabilizerWithdrawal</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>NR_NeurostabilizerAddiction</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <visible>false</visible>
      </li>
      <li>
        <label>neurostabilizer withdrawal</label>
        <description>My head buzzes like a bad uplink. One more capsule and it would all go quiet.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
