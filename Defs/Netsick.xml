<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Cyberspace dependency balance numbers. Tweak here, no code changes needed. -->
  <Netrun.NetsickSettingsDef>
    <defName>NR_NetsickSettings</defName>

    <!-- Growth: per day in a cyberpod, per hack from a pod (hacks on the map do not count).
         A AI coprocessor multiplies pod growth by coprocessorNetsickFactor (Defs/Heat.xml). -->
    <podGainPerDay>0.10</podGainPerDay>
    <podHackGain>0.02</podHackGain>

    <!-- Recovery per day while disconnected -->
    <decayPerDay>0.06</decayPerDay>

    <!-- "A living day off": recovery is this many times faster while the pawn enjoys live leisure of these kinds
         (talking, walks and meditation, games, the telescope, art). Screens and drugs do not count. -->
    <liveLeisureDecayFactor>2</liveLeisureDecayFactor>
    <liveJoyKinds>
      <li>Social</li>
      <li>Meditative</li>
      <li>Gaming_Dexterity</li>
      <li>Gaming_Cerebral</li>
      <li>Telescope</li>
      <li>HighCulture</li>
    </liveJoyKinds>

    <!-- Withdrawal: offline for this many days while at least this severe -->
    <withdrawalAfterDays>1</withdrawalAfterDays>
    <withdrawalMinSeverity>0.3</withdrawalMinSeverity>

    <!-- "Net craving" break: dive length, chance it goes wrong, chance of a legendary dive,
         advanced cyberdata found, chance of an AI fragment on top, extra Netsick on failure -->
    <emotionalDiveHours>2</emotionalDiveHours>
    <!-- After an emotional dive, no new net craving for this many days (and none while nausea, lockout or coma last) -->
    <cravingCooldownDays>3</cravingCooldownDays>
    <emotionalFailChance>0.65</emotionalFailChance>
    <emotionalJackpotChance>0.12</emotionalJackpotChance>
    <jackpotAdvancedData>3~5</jackpotAdvancedData>
    <jackpotFragmentChance>0.15</jackpotFragmentChance>
    <failNetsickGain>0.1</failNetsickGain>

    <!-- Neural load (hediff NR_NeuralLoad, -0.5 a day): +neuralLoadPerDive per dive; the Netsick from a dive is multiplied by
         the factor of the load stage it had before the dive (stage 0 / 1 / 2 = below 0.5 / from 0.5 / from 1.0). -->
    <neuralLoadPerDive>0.25</neuralLoadPerDive>
    <neuralLoadNetsickFactors>
      <li>1</li>
      <li>2</li>
      <li>3</li>
    </neuralLoadNetsickFactors>
    <neuralLoadHackPenalties>
      <li>0</li>
      <li>0.05</li>
      <li>0.1</li>
    </neuralLoadHackPenalties>
    <!-- Actions added to the first turn of a dive at each load stage (overload: one less) -->
    <neuralLoadFirstTurnActions>
      <li>0</li>
      <li>0</li>
      <li>-1</li>
    </neuralLoadFirstTurnActions>
  </Netrun.NetsickSettingsDef>

  <HediffDef>
    <defName>NR_Netsick</defName>
    <hediffClass>Netrun.Hediff_Netsick</hediffClass>
    <label>netsick</label>
    <description>Dependency on cyberspace. Long sessions and hacks in a cyberpod make the physical world feel slow and flat. It fades with time spent offline, but a strong dependency hurts when cut off and can drive the netrunner back into the pod against all reason.</description>
    <defaultLabelColor>(0.4, 0.9, 1)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.01</initialSeverity>
    <stages>
      <li>
        <label>mild</label>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>noticeable</label>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>strong</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>NR_NetCraving</mentalState>
            <mtbDays>8</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>severe</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>NR_NetCraving</mentalState>
            <mtbDays>3</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <!-- Neural load: every dive adds 0.25, it fades 0.5 a day, so two dives a day are free. No tick of its own. -->
  <HediffDef>
    <defName>NR_NeuralLoad</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>neural load</label>
    <description>The brain is tired from diving. Every dive adds to the load and it fades by half a day. The higher the load, the more Netsick the next dive gives: x1 when light, x2 when heavy, x3 on overload, and hacking gets 5% and 10% worse; on overload the first dive turn has one action less. Two dives a day are free, the third already hurts.</description>
    <defaultLabelColor>(0.9, 0.6, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>0.01</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.5</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>light, Netsick from dives x1</label>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>heavy, Netsick from dives x2, hacking -5%</label>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>overload, Netsick from dives x3, hacking -10%, -1 action in the first turn</label>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>NR_NetsickWithdrawal</defName>
    <workerClass>Netrun.ThoughtWorker_NetsickWithdrawal</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>reality feels flat</label>
        <description>Everything out here is so slow. I keep reaching for an interface that isn't there.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>cut off from the net</label>
        <description>The world is grey and muffled. I need to jack in. Just for a little while.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>starving for the net</label>
        <description>Every second offline is wasted. My body is a cage. The pod is right there.</description>
        <baseMoodEffect>-16</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <MentalStateDef ParentName="BaseMentalState">
    <defName>NR_NetCraving</defName>
    <stateClass>Netrun.MentalState_NetCraving</stateClass>
    <workerClass>Netrun.MentalStateWorker_NetCraving</workerClass>
    <label>net craving</label>
    <category>Misc</category>
    <colonistsOnly>true</colonistsOnly>
    <minTicksBeforeRecovery>2500</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>15000</maxTicksBeforeRecovery>
    <recoveryMtbDays>1</recoveryMtbDays>
    <nameColor>(0.4, 0.9, 1)</nameColor>
    <recoveryMessage>{0} no longer craves the net.</recoveryMessage>
    <beginLetterLabel>net craving</beginLetterLabel>
    <beginLetter>{0} can't stand being offline any longer and is heading for a cyberpod to dive on raw emotion.\n\nDives like this usually end badly. Sometimes they turn out legendary.</beginLetter>
    <beginLetterDef>NegativeEvent</beginLetterDef>
    <baseInspectLine>Mental state: Net craving</baseInspectLine>
    <escapingPrisonersIgnore>true</escapingPrisonersIgnore>
  </MentalStateDef>

</Defs>
