<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Raw recording: made by braindance goggles, edited into a chip at the network console -->

  <ThingDef ParentName="ResourceBase">
    <defName>NR_BraindanceRaw</defName>
    <label>raw braindance recording</label>
    <description>Unedited sensory data captured by braindance goggles: everything the wearer saw and felt in a strong moment. Carry it to a network console to edit it into a playable chip.</description>
    <graphicData>
      <texPath>Things/Item/NR_BraindanceRaw</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>25</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <thingCategories>
      <li>NR_Braindance</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="Netrun.CompProperties_BraindanceRecord" />
    </comps>
  </ThingDef>

  <!-- Bonus from a good recording (by CompBraindanceRecord, stage = quality - 1) -->

  <ThoughtDef>
    <defName>NR_BraindanceGoodRecording</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>great braindance</label>
        <description>That recording was so real. I keep thinking about it.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <li>
        <label>masterful braindance</label>
        <description>The best recording I have ever played. For a while I really was someone else.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Watching one's own memory or a loved one's (BraindanceUtility.RelativeMemory): own, alive, dead -->
  <ThoughtDef>
    <defName>NR_BraindanceRelativeMemory</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>relived my own memory</label>
        <description>I went back to a moment of my own life. It felt good to be there again.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>saw through a loved one's eyes</label>
        <description>I felt what someone close to me felt. I understand them better now.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
      <li>
        <label>memory of someone I lost</label>
        <description>For a while they were alive again, and I was right there with them. It hurts, but I am grateful.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <JobDef>
    <defName>NR_EditBraindance</defName>
    <driverClass>Netrun.JobDriver_EditBraindance</driverClass>
    <reportString>editing a braindance recording.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>NR_EditBraindanceBatch</defName>
    <driverClass>Netrun.JobDriver_EditBraindanceBatch</driverClass>
    <reportString>editing all braindance recordings.</reportString>
  </JobDef>

</Defs>
