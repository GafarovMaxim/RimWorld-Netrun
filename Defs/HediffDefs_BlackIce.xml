<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>BI_BrainDanceEuphoria</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>braindance immersion</label>
    <description>The boundaries between the user's memories and a recorded experience have become temporarily blurred.</description>
    <isBad>false</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <GlobalWorkSpeed>0.05</GlobalWorkSpeed>
          <Consciousness>0.05</Consciousness>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.55</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>BI_BrainDanceTolerance</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>braindance tolerance</label>
    <isBad>true</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <statOffsets>
          <JoyGainFactor>-0.05</JoyGainFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <statOffsets>
          <JoyGainFactor>-0.15</JoyGainFactor>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.04</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>BI_CyberspaceDependency</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>cyberspace dependency</label>
    <description>Repeated immersion in networked reality has made ordinary physical existence feel comparatively dull.</description>
    <isBad>true</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <statOffsets>
          <JoyGainFactor>-0.05</JoyGainFactor>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <statOffsets>
          <JoyGainFactor>-0.12</JoyGainFactor>
          <GlobalWorkSpeed>-0.05</GlobalWorkSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <statOffsets>
          <JoyGainFactor>-0.20</JoyGainFactor>
          <GlobalWorkSpeed>-0.10</GlobalWorkSpeed>
          <Consciousness>-0.05</Consciousness>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>BI_ICEFeedback</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>ICE feedback</label>
    <description>Defensive code has struck the neural interface.</description>
    <isBad>true</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <Consciousness>-0.05</Consciousness>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.5</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>BI_NeuralNoise</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>network neural noise</label>
    <description>Foreign traffic is interfering with the colonist's neural interfaces.</description>
    <isBad>true</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <Consciousness>-0.08</Consciousness>
          <MoveSpeed>-0.05</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
      </li>
    </comps>
  </HediffDef>
</Defs>
