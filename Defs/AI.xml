<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- AI balance numbers. Tweak here, no code changes needed. -->
  <Netrun.AISettingsDef>
    <defName>NR_AI</defName>

    <!-- Server slots: at start and the maximum reachable with core modules -->
    <baseSlots>1</baseSlots>
    <maxSlots>3</maxSlots>

    <!-- Awakening: work ticks at hacking speed 100% (2500 ticks = 1 hour),
         detection chance per point of Heat, Heat added when detected -->
    <awakenWorkTicks>5000</awakenWorkTicks>
    <awakenDetectChancePerHeat>0.006</awakenDetectChancePerHeat>
    <awakenDetectHeat>10</awakenDetectHeat>

    <!-- Finds on completed hacks: AI fragment from core-command ICE / Black ICE targets,
         core module from Black ICE targets and satellite black boxes -->
    <fragmentChanceCoreCommandICE>0.1</fragmentChanceCoreCommandICE>
    <fragmentChanceBlackICE>0.25</fragmentChanceBlackICE>
    <moduleChanceBlackICE>0.05</moduleChanceBlackICE>
    <moduleChanceBlackBox>0.1</moduleChanceBlackBox>

    <!-- Trust and hunger, 0-100. Starving (hunger above starvingHunger) and isolation cost trust daily.
         Ghost is not fed: its hunger grows per hack and drops on quiet days (no hacks for a day). -->
    <startTrust>50</startTrust>
    <hungerPerDay>8</hungerPerDay>
    <starvingHunger>70</starvingHunger>
    <starvingTrustPerDay>2</starvingTrustPerDay>
    <isolatedTrustPerDay>3</isolatedTrustPerDay>
    <isolatedHungerFactor>2</isolatedHungerFactor>
    <feedHungerRelief>50</feedHungerRelief>
    <feedTrust>5</feedTrust>
    <ghostHungerPerHack>15</ghostHungerPerHack>
    <ghostCalmPerDay>15</ghostCalmPerDay>

    <!-- Services: trust needed, cooldown, and what each personality does -->
    <minTrustForService>20</minTrustForService>
    <serviceCooldownDays>4</serviceCooldownDays>
    <!-- Each service costs trust and makes the AI hungrier (BALANCE.md section 4) -->
    <serviceTrustCost>7</serviceTrustCost>
    <serviceHungerCost>10</serviceHungerCost>
    <dataHunterData>2~4</dataHunterData>
    <dataHunterHeat>2</dataHunterHeat>
    <ghostHeatScrub>10</ghostHeatScrub>
    <wardenTrust>10</wardenTrust>
    <oracleDeadlineDays>1</oracleDeadlineDays>
    <forgeResearch>600</forgeResearch>
    <sirenReputation>10</sirenReputation>
    <tricksterBadChance>0.35</tricksterBadChance>
    <tricksterHeat>10</tricksterHeat>

    <!-- Requests: how often, how long to answer, how much food (x one feeding), trust won or lost -->
    <requestIntervalDays>8~12</requestIntervalDays>
    <requestDays>3</requestDays>
    <requestFeedMultiplier>2</requestFeedMultiplier>
    <requestTrust>15</requestTrust>

    <!-- Erasing an AI gives back advanced cyberdata. "Fell asleep" notice delay in hours (power flickers stay quiet). -->
    <eraseAdvancedCyberdata>2</eraseAdvancedCyberdata>
    <sleepNoticeHours>2</sleepNoticeHours>

    <!-- Random AI events: interval in days; trust for a helpful event; below eventBadTrust the AI causes trouble -->
    <eventIntervalDays>4~8</eventIntervalDays>
    <eventGoodTrust>50</eventGoodTrust>
    <eventBadTrust>30</eventBadTrust>
    <eventBadHeat>6</eventBadHeat>
    <!-- AI event letters: at most one per colony per this many hours, and this many days to answer. The mod setting scales the frequency. -->
    <colonyEventGapHours>36</colonyEventGapHours>
    <eventAnswerDays>2</eventAnswerDays>
  </Netrun.AISettingsDef>

  <!-- Predator service: a temporary edge for every hacker with a cyberlink -->
  <HediffDef>
    <defName>NR_PredatorBoost</defName>
    <label>predator overclock</label>
    <description>A hunting AI rides along in this hacker's cyberlink, pushing every intrusion harder and quieter.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.3, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <HackingSpeed>0.3</HackingSpeed>
          <HackingStealth>30</HackingStealth>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Echo service: the colony feels a lost friend nearby -->
  <ThoughtDef>
    <defName>NR_EchoPresence</defName>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>an echo of a friend</label>
        <description>For a moment I heard a voice I thought I had lost. It is still out there, in the network.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Sleeping AI fragment -->
  <ThingDef ParentName="ResourceBase">
    <defName>NR_AIFragment</defName>
    <label>AI fragment</label>
    <description>A self-contained shard of an unknown artificial intelligence. It is not merely data: something inside is still thinking.\n\nA colonist can awaken it at a network console and move it into an AI server. Its personality stays hidden until then.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/NR_AIFragment</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <techLevel>Spacer</techLevel>
    <statBases>
      <MarketValue>1200</MarketValue>
      <Mass>0.2</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="Netrun.CompProperties_AIFragment" />
    </comps>
  </ThingDef>

  <!-- Rare server upgrade -->
  <ThingDef ParentName="ResourceBase">
    <defName>NR_AICoreModule</defName>
    <label>AI core module</label>
    <description>An old-world processing module with a living lattice of qubits. Needed to build a server rack, which opens one more slot for an AI. Almost impossible to find: they turn up behind black ICE and in fallen satellites.</description>
    <graphicData>
      <texPath>Things/Item/NR_AICoreModule</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>5</stackLimit>
    <techLevel>Archotech</techLevel>
    <statBases>
      <MarketValue>4000</MarketValue>
      <Mass>0.5</Mass>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
  </ThingDef>

  <!-- AI server -->
  <ThingDef ParentName="BuildingBase">
    <defName>NR_AIServer</defName>
    <label>AI server</label>
    <description>A shielded server rack built to host awakened AIs. Needs power: without it the AIs inside fall asleep. Only one can be built. Starts with one slot; server racks built next to it add more, up to three.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/NR_AIServer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.9</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <Plasteel>60</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <USH_AdvancedCyberdata>4</USH_AdvancedCyberdata>
    </costList>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <designationCategory>NR_Cyberspace</designationCategory>
    <researchPrerequisites>
      <li>USH_AdvancedCybertech</li>
    </researchPrerequisites>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <placeWorkers>
      <li>Netrun.PlaceWorker_OnlyOneAIServer</li>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="Netrun.CompProperties_AIServer" />
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>NR_AIServerRack</li>
        </linkableFacilities>
      </li>
    </comps>
  </ThingDef>

  <!-- Server rack: an extension built next to the AI server, +1 AI slot each (up to 2 racks) -->
  <ThingDef ParentName="BuildingBase">
    <defName>NR_AIServerRack</defName>
    <label>AI server rack</label>
    <description>An extension rack for the AI server, built around a rare AI core module. Linked to a powered server, it gives one more slot for an AI. Up to two racks can link to the server.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/NR_AIServerRack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.1, 1.1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentSpacer>2</ComponentSpacer>
      <NR_AICoreModule>1</NR_AICoreModule>
    </costList>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <designationCategory>NR_Cyberspace</designationCategory>
    <researchPrerequisites>
      <li>USH_AdvancedCybertech</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Facility">
        <maxSimultaneous>2</maxSimultaneous>
        <maxDistance>6</maxDistance>
      </li>
    </comps>
  </ThingDef>

  <JobDef>
    <defName>NR_UseNetTerminal</defName>
    <driverClass>Netrun.JobDriver_UseNetTerminal</driverClass>
    <reportString>using the network terminal.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>NR_DeliverToAI</defName>
    <driverClass>Netrun.JobDriver_DeliverToAI</driverClass>
    <reportString>bringing TargetB to TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>NR_AwakenAI</defName>
    <driverClass>Netrun.JobDriver_AwakenAI</driverClass>
    <reportString>awakening an AI fragment.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

</Defs>
