<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <PawnGroupKindDef>
    <defName>NR_CourierHunt</defName>
    <workerClass>PawnGroupKindWorker_Normal</workerClass>
  </PawnGroupKindDef>

  <!-- Hidden mercenary faction: no settlements, comes only as raids (see Mercenaries.cs) -->

  <FactionDef ParentName="FactionBase">
    <defName>NR_Mercenaries</defName>
    <label>black ledger mercenaries</label>
    <description>Hired guns who follow digital trails. Nobody knows who pays them: corporations, fixers or the people you hacked. They have no home on this planet, only contracts.</description>
    <pawnSingular>mercenary</pawnSingular>
    <pawnsPlural>mercenaries</pawnsPlural>
    <fixedName>Black Ledger</fixedName>
    <hidden>true</hidden>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <!-- No settlements: keep vanilla quests (Anomaly distress call, Ideology work sites) from picking this faction -->
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <permanentEnemy>true</permanentEnemy>
    <humanlikeFaction>true</humanlikeFaction>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>handler</leaderTitle>
    <factionIconPath>UI/Netrun/Faction_Mercenaries</factionIconPath>
    <colorSpectrum>
      <li>(0.15, 0.15, 0.18)</li>
      <li>(0.9, 0.2, 0.3)</li>
    </colorSpectrum>
    <techLevel>Spacer</techLevel>
    <allowedCultures><li>Kriminul</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
    </requiredMemes>
    <backstoryFilters>
      <li>
        <categories>
          <li>Pirate</li>
        </categories>
      </li>
    </backstoryFilters>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>PirateRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <!-- Even the smallest raid can be one gunner (85), not only grenadiers; heavies, snipers and elites come with more points -->
        <li>(0, 90)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <!-- The courier's hunters: they came for him, not for the base, so small arms only (no grenades, no rocket launchers) -->
        <kindDef>NR_CourierHunt</kindDef>
        <commonality>90</commonality>
        <options>
          <Mercenary_Gunner>10</Mercenary_Gunner>
          <Mercenary_Elite>4</Mercenary_Elite>
          <Mercenary_Sniper>3</Mercenary_Sniper>
          <Mercenary_Slasher>3</Mercenary_Slasher>
        </options>
      </li>
      <li>
        <!-- Rarely (1 hunt in 10) the hunters bring grenades and launchers along -->
        <kindDef>NR_CourierHunt</kindDef>
        <commonality>10</commonality>
        <options>
          <Mercenary_Gunner>10</Mercenary_Gunner>
          <Mercenary_Elite>3</Mercenary_Elite>
          <Grenadier_Destructive>3</Grenadier_Destructive>
          <Mercenary_Heavy>3</Mercenary_Heavy>
        </options>
      </li>
      <li>
        <!-- Strike team: gunners with elite leads -->
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Mercenary_Gunner>10</Mercenary_Gunner>
          <Mercenary_Elite>6</Mercenary_Elite>
          <Mercenary_Sniper>3</Mercenary_Sniper>
          <Mercenary_Slasher>3</Mercenary_Slasher>
        </options>
      </li>
      <li>
        <!-- Heavy team: breach and burn, with gunners for cover -->
        <kindDef>Combat</kindDef>
        <commonality>40</commonality>
        <options>
          <Mercenary_Heavy>8</Mercenary_Heavy>
          <Mercenary_Gunner>8</Mercenary_Gunner>
          <Grenadier_Destructive>3</Grenadier_Destructive>
          <Mercenary_Elite>3</Mercenary_Elite>
        </options>
      </li>
      <li>
        <!-- Overwatch team: snipers -->
        <kindDef>Combat</kindDef>
        <commonality>25</commonality>
        <options>
          <Mercenary_Sniper>10</Mercenary_Sniper>
          <Mercenary_Elite>2</Mercenary_Elite>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <IncidentDef>
    <defName>NR_MercRaid</defName>
    <label>mercenary raid</label>
    <category>ThreatBig</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Netrun.IncidentWorker_MercRaid</workerClass>
    <baseChance>0.6</baseChance>
    <minRefireDays>12</minRefireDays>
    <tale>Raid</tale>
    <pointsScaleable>true</pointsScaleable>
  </IncidentDef>

</Defs>
