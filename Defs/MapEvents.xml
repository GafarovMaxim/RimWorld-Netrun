<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Map events (docs/PHASE5_MAPEVENTS.md) -->
  <Netrun.MapEventsSettingsDef>
    <defName>NR_MapEvents</defName>
    <!-- Map events (courier, black market, distress signal, network hijack) come from their own schedule, not the storyteller:
         one every this many days on average, divided by the "map events" frequency in the mod settings. -->
    <mapEventMtbDays>5</mapEventMtbDays>
    <courierDays>1</courierDays>
    <courierHuntersHours>4~8</courierHuntersHours>
    <courierHuntersPoints>0.5</courierHuntersPoints>
    <courierSilver>250</courierSilver>
    <!-- Cyberdata the courier carries: it drops if the courier is killed (the job fails) -->
    <courierCyberdata>6~10</courierCyberdata>
    <courierReputation>10</courierReputation>
    <courierFailHeat>10</courierFailHeat>
    <courierFailReputation>5</courierFailReputation>
    <blackMarketDays>2</blackMarketDays>
    <blackMarketReputation>30</blackMarketReputation>
    <blackMarketCoreChance>0.3</blackMarketCoreChance>
    <distressWorkHours>2</distressWorkHours>
    <distressFragmentChance>0.4</distressFragmentChance>
    <mapHackTurrets>3</mapHackTurrets>
    <mapHackHours>12</mapHackHours>
    <mapHackWinHeat>5</mapHackWinHeat>
    <mapHackLoseBreakdowns>2</mapHackLoseBreakdowns>
    <!-- The first encrypted crate opened at home in the first days: +22 to Hacking Expansion's 3-6, so a newcomer starts with 25+. -->
    <starterCrateCyberdata>22</starterCrateCyberdata>
    <starterCrateDays>15</starterCrateDays>
  </Netrun.MapEventsSettingsDef>

  <IncidentDef>
    <defName>NR_DataCourier</defName>
    <label>data courier</label>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>Netrun.IncidentWorker_DataCourier</workerClass>
    <baseChance>0.4</baseChance>
    <minRefireDays>12</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>NR_CorpHunt</defName>
    <label>corporate hunt</label>
    <category>ThreatBig</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>Netrun.IncidentWorker_CorpHunt</workerClass>
    <baseChance>0.4</baseChance>
    <minRefireDays>15</minRefireDays>
    <pointsScaleable>true</pointsScaleable>
    <tale>Raid</tale>
  </IncidentDef>

  <IncidentDef>
    <defName>NR_BlackMarket</defName>
    <label>black market</label>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>Netrun.IncidentWorker_BlackMarket</workerClass>
    <baseChance>0.3</baseChance>
    <minRefireDays>15</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>NR_DistressSignal</defName>
    <label>distress signal</label>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>Netrun.IncidentWorker_DistressSignal</workerClass>
    <baseChance>0.3</baseChance>
    <minRefireDays>20</minRefireDays>
  </IncidentDef>

  <IncidentDef>
    <defName>NR_MapHack</defName>
    <label>network hijack</label>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>Netrun.IncidentWorker_MapHack</workerClass>
    <baseChance>0.4</baseChance>
    <minRefireDays>12</minRefireDays>
  </IncidentDef>

  <!-- The abandoned server from a distress signal -->
  <ThingDef ParentName="BuildingBase">
    <defName>NR_DistressServer</defName>
    <label>abandoned server</label>
    <description>An old server, still sending a weak distress signal. Something may be alive inside. A colonist can connect to it.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/NR_DistressServer</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <size>(3,3)</size>
    <rotatable>true</rotatable>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <comps>
      <li Class="Netrun.CompProperties_DistressServer" />
    </comps>
  </ThingDef>

  <!-- The distress signal's site on the world map -->
  <SitePartDef>
    <defName>NR_DistressSite</defName>
    <label>abandoned server</label>
    <description>An old server, still sending a weak distress signal. Something may be alive inside.</description>
    <workerClass>SitePartWorker</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>UI/Netrun/Cyberspace/Event_DistressSignal</expandingIconTexture>
    <applyFactionColorToSiteTexture>false</applyFactionColorToSiteTexture>
    <requiresFaction>false</requiresFaction>
    <tags>
      <li>NR_DistressSite</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>NR_DistressSite</defName>
    <linkWithSite>NR_DistressSite</linkWithSite>
    <order>450</order>
    <genStep Class="Netrun.GenStep_DistressServer" />
  </GenStepDef>

  <!-- Dead racks around the abandoned server: decoration, deconstruct for a little steel -->
  <ThingDef ParentName="BuildingBase">
    <defName>NR_DistressRack</defName>
    <label>dead server rack</label>
    <description>A rack of burned-out servers next to the abandoned one, its cables torn and patched. Nothing works here any more, but the steel is good.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/NR_DistressRack</texPath>
      <drawOffset>(0,0,0.2)</drawOffset>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.45, 1.45)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>20</Steel>
    </costList>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <building>
      <deconstructible>true</deconstructible>
    </building>
  </ThingDef>

  <JobDef>
    <defName>NR_ConnectDistressServer</defName>
    <driverClass>Netrun.JobDriver_ConnectDistressServer</driverClass>
    <reportString>connecting to the abandoned server.</reportString>
  </JobDef>

  <!-- The fixer asks to shelter a data courier: accept or refuse (Source/MapEvents/MapEvents.cs, ChoiceLetter_CourierOffer) -->
  <LetterDef>
    <defName>NR_CourierOffer</defName>
    <letterClass>Netrun.ChoiceLetter_CourierOffer</letterClass>
    <color>(0.94, 0.75, 0.25)</color>
    <flashColor>(0.94, 0.75, 0.25)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
  </LetterDef>


  <!-- The data courier lies low in the room he was given, out of fights (LordJob_CourierHide) -->
  <DutyDef>
    <defName>NR_CourierHide</defName>
    <hook>HighPriority</hook>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="Netrun.JobGiver_CourierHide" />
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
