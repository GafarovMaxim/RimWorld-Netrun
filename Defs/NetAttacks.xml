<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Network attacks: the storyteller picks them only once Heat reaches minLevel (see IncidentWorker_NetAttack) -->

  <IncidentDef>
    <defName>NR_NetAttack_NeuralNoise</defName>
    <label>neural noise</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Netrun.IncidentWorker_NetNeuralNoise</workerClass>
    <baseChance>0.6</baseChance>
    <minRefireDays>8</minRefireDays>
    <modExtensions>
      <li Class="Netrun.NetAttackExtension">
        <minLevel>Noticed</minLevel>
        <!-- Attack strength = this + Heat level (0-4); against the node defense -->
        <strength>3</strength>
      </li>
    </modExtensions>
  </IncidentDef>

