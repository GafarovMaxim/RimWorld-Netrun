    <defName>NR_Guide_onboarding_list</defName>
    <label>Getting online</label>
    <area>onboarding.list</area>
    <screen>Onboarding</screen>
    <order>1</order>
    <helpPage>NR_Help_Start</helpPage>
    <steps>
      <li>
        <text>These steps bring your colony online. Done steps turn green; the yellow one is next.</text>
      </li>
      <li>
        <text>When all are done, the Core opens and its sections unlock one by one. "Skip" shows the full Core right away.</text>
      </li>
    </steps>
  </Netrun.GuideAreaDef>

