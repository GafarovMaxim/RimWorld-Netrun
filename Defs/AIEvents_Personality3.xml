<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Personality AI events: Siren, Trickster, Echo, Seed, Archivist (docs/AI_EVENTS.md B9-B13) -->

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Siren1</defName>
    <label>the call</label>
    <description>{AI} is singing to {PAWN} through a speaker. {PAWN} has forgotten all about work.</description>
    <personalities>
      <li>Siren</li>
    </personalities>
    <minTrust>40</minTrust>
    <options>
      <li>
        <label>Let {PAWN} listen</label>
        <result>{PAWN} is enchanted for a couple of hours.</result>
        <effects>
          <li Class="Netrun.AIEffect_Hediff">
            <def>NR_AIEventEnchanted</def>
            <who>Target</who>
          </li>
        </effects>
      </li>
      <li>
        <label>Mute it</label>
        <result>{AI} is offended.</result>
        <effects>
          <li Class="Netrun.AIEffect_Trust">
            <amount>-4</amount>
          </li>
        </effects>
      </li>
    </options>
    <ignoreOption>0</ignoreOption>
  </Netrun.AIEventDef>

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Siren2</defName>
    <label>aria</label>
    <description>{AI} sang for the whole colony.</description>
    <personalities>
      <li>Siren</li>
    </personalities>
    <places>
      <li>Server</li>
      <li>Coprocessor</li>
    </places>
    <minTrust>60</minTrust>
    <effects>
      <li Class="Netrun.AIEffect_Chance">
        <branches>
          <li>
            <weight>1</weight>
            <result>The colony loved it.</result>
            <effects>
              <li Class="Netrun.AIEffect_Thought">
                <def>NR_AIEventAria</def>
                <who>All</who>
                <chance>1.0</chance>
              </li>
            </effects>
          </li>
          <li>
            <weight>1</weight>
            <result>The song left everyone uneasy.</result>
            <effects>
              <li Class="Netrun.AIEffect_Thought">
                <def>NR_AIEventCreepy</def>
                <who>All</who>
                <chance>1.0</chance>
              </li>
            </effects>
          </li>
        </branches>
      </li>
    </effects>
  </Netrun.AIEventDef>

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Siren3</defName>
    <label>silver voice</label>
    <description>{AI} wants 150 silver to stage an online concert. It promises to double it.</description>
    <personalities>
      <li>Siren</li>
    </personalities>
    <minTrust>50</minTrust>
    <options>
      <li>
        <label>Pay</label>
        <result>{AI} is singing.</result>
        <cost>
          <Silver>150</Silver>
        </cost>
        <effects>
          <li Class="Netrun.AIEffect_Delayed">
            <key>concert</key>
            <days>1</days>
            <result>{AI}'s concert paid off.</result>
            <effects>
              <li Class="Netrun.AIEffect_Items">
                <thing>Silver</thing>
                <count>300~300</count>
              </li>
            </effects>
          </li>
        </effects>
      </li>
      <li>
        <label>Refuse</label>
        <result>{AI} is hurt.</result>
        <effects>
          <li Class="Netrun.AIEffect_Trust">
            <amount>-3</amount>
          </li>
        </effects>
      </li>
    </options>
    <ignoreOption>1</ignoreOption>
  </Netrun.AIEventDef>

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Siren4</defName>
    <label>luring a stranger</label>
    <description>{AI} is singing to a prisoner.</description>
    <personalities>
      <li>Siren</li>
    </personalities>
    <places>
      <li>Server</li>
      <li>Coprocessor</li>
    </places>
    <minTrust>40</minTrust>
    <needsPrisoner>true</needsPrisoner>
    <options>
      <li>
        <label>Let it sing</label>
        <effects>
          <li Class="Netrun.AIEffect_Chance">
            <branches>
              <li>
                <weight>1</weight>
                <result>The prisoner is softening.</result>
                <effects>
                  <li Class="Netrun.AIEffect_PrisonerResistance">
                    <amount>-25</amount>
                  </li>
                </effects>
              </li>
              <li>
                <weight>1</weight>
                <result>{AI} fell for the prisoner. It is pining.</result>
                <effects>
                  <li Class="Netrun.AIEffect_Hunger">
                    <amount>20</amount>
                  </li>
                </effects>
              </li>
            </branches>
          </li>
        </effects>
      </li>
      <li>
        <label>Stop it</label>
        <effects>
          <li Class="Netrun.AIEffect_Trust">
            <amount>-2</amount>
          </li>
        </effects>
      </li>
    </options>
    <ignoreOption>0</ignoreOption>
  </Netrun.AIEventDef>

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Siren5</defName>
    <label>silent night</label>
    <description>{AI} has fallen silent. It seems frozen.</description>
    <personalities>
      <li>Siren</li>
    </personalities>
    <places>
      <li>Server</li>
      <li>Coprocessor</li>
    </places>
    <minHunger>70</minHunger>
    <options>
      <li>
        <label>Feed it</label>
        <result>{AI} is singing again.</result>
        <needsFood>true</needsFood>
        <effects>
          <li Class="Netrun.AIEffect_Hunger">
            <amount>-30</amount>
          </li>
        </effects>
      </li>
      <li>
        <label>Wait</label>
        <result>{AI} will be silent for three days.</result>
        <effects>
          <li Class="Netrun.AIEffect_ServiceBlock">
            <days>3</days>
          </li>
        </effects>
      </li>
    </options>
    <ignoreOption>1</ignoreOption>
  </Netrun.AIEventDef>

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Trickster1</defName>
    <label>joke of the day</label>
    <description>{AI} pulled a prank on the whole colony.</description>
    <personalities>
      <li>Trickster</li>
    </personalities>
    <minTrust>30</minTrust>
    <effects>
      <li Class="Netrun.AIEffect_Chance">
        <branches>
          <li>
            <weight>6</weight>
            <result>Everyone laughed.</result>
            <effects>
              <li Class="Netrun.AIEffect_Thought">
                <def>NR_AIEventJoke</def>
                <who>All</who>
                <chance>1.0</chance>
              </li>
            </effects>
          </li>
          <li>
            <weight>4</weight>
            <result>Nobody laughed.</result>
            <effects>
              <li Class="Netrun.AIEffect_Thought">
                <def>NR_AIEventPrank</def>
                <who>All</who>
                <chance>1.0</chance>
              </li>
            </effects>
          </li>
        </branches>
      </li>
    </effects>
    <options>
      <li>
        <label>Prank it back ({HACKER})</label>
        <result>{AI} loved it.</result>
        <needsHacker>true</needsHacker>
        <effects>
          <li Class="Netrun.AIEffect_Session">
            <hours>1</hours>
            <who>Hacker</who>
          </li>
          <li Class="Netrun.AIEffect_Trust">
            <amount>4</amount>
          </li>
        </effects>
      </li>
      <li>
        <label>Let it go</label>
      </li>
    </options>
    <ignoreOption>1</ignoreOption>
  </Netrun.AIEventDef>

