    <description>{AI} offers to give the colony a lecture.</description>
    <personalities>
      <li>Archivist</li>
    </personalities>
    <places>
      <li>Server</li>
      <li>Coprocessor</li>
    </places>
    <minTrust>70</minTrust>
    <options>
      <li>
        <label>Listen</label>
        <result>Everyone learned something.</result>
        <effects>
          <li Class="Netrun.AIEffect_Skill">
            <amount>500</amount>
            <who>All</who>
            <randomSkill>true</randomSkill>
          </li>
        </effects>
      </li>
      <li>
        <label>Not now</label>
        <result>{AI} is disappointed.</result>
        <effects>
          <li Class="Netrun.AIEffect_Trust">
            <amount>-2</amount>
          </li>
        </effects>
      </li>
    </options>
    <ignoreOption>1</ignoreOption>
  </Netrun.AIEventDef>

  <Netrun.AIEventDef>
    <defName>NR_AIEvent_Archivist5</defName>
    <label>lost files</label>
    <description>{AI} "forgot" an important document from one of your contracts.</description>
    <personalities>
      <li>Archivist</li>
    </personalities>
    <places>
      <li>Server</li>
      <li>Coprocessor</li>
    </places>
    <minHunger>60</minHunger>
    <needsContract>true</needsContract>
    <options>
      <li>
        <label>Feed it</label>
