<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Generated by tools/gen_sounds.py. Volumes are percent; see docs/SOUNDS.md for where each sound is played. -->

  <!-- button press -->
  <SoundDef>
    <defName>NR_UI_Click</defName>
    <context>Any</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Netrun/UI/Click</clipFolderPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>0.96~1.04</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- hover over a button or node (rate-limit: not more than once per 80 ms) -->
  <SoundDef>
    <defName>NR_UI_Hover</defName>
    <context>Any</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Netrun/UI/Hover</clipFolderPath></li></grains>
        <volumeRange>30~30</volumeRange>
        <pitchRange>0.97~1.03</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- one key tick while text is being typed in -->
  <SoundDef>
    <defName>NR_UI_Type</defName>
    <context>Any</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Netrun/UI/Type</clipFolderPath></li></grains>
        <volumeRange>38~38</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- confirm: contract accepted, deal made, scrub done -->
  <SoundDef>
    <defName>NR_UI_Confirm</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/confirm</clipPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- refusal: unavailable action, failed deal -->
  <SoundDef>
    <defName>NR_UI_Deny</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/deny</clipPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- switch of a tab or a screen -->
  <SoundDef>
    <defName>NR_UI_Tab</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/tab</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>0.98~1.02</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- the terminal window opens -->
  <SoundDef>
    <defName>NR_UI_Open</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/open</clipPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- the terminal window closes -->
  <SoundDef>
    <defName>NR_UI_Close</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/close</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- short glitch (bottom bar on screen change, node frames); only with animations on -->
  <SoundDef>
    <defName>NR_UI_Glitch</defName>
    <context>Any</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Netrun/UI/Glitch</clipFolderPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>0.92~1.08</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- new Archive entry, letter from the net -->
  <SoundDef>
    <defName>NR_UI_Notify</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/notify</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Heat reached Target or Red zone, counter-hack, raid warning -->
  <SoundDef>
    <defName>NR_UI_Alert</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/alert</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Heat level went up -->
  <SoundDef>
    <defName>NR_UI_HeatUp</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/heat_up</clipPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Heat level went down, scrub done -->
  <SoundDef>
    <defName>NR_UI_HeatDown</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/heat_down</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- node search, Scan action in a dive -->
  <SoundDef>
    <defName>NR_UI_Scan</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/scan</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Download action, cyberdata received -->
  <SoundDef>
    <defName>NR_UI_Download</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/download</clipPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Hack action of a dive passes a gate -->
  <SoundDef>
    <defName>NR_UI_Hack</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/UI/hack</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- a dive starts -->
  <SoundDef>
    <defName>NR_Dive_Start</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Dive/start</clipPath></li></grains>
        <volumeRange>60~60</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- clean exit from a dive -->
  <SoundDef>
    <defName>NR_Dive_Success</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Dive/success</clipPath></li></grains>
        <volumeRange>60~60</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- dive failed or aborted -->
  <SoundDef>
    <defName>NR_Dive_Fail</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Dive/fail</clipPath></li></grains>
        <volumeRange>60~60</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- hit from ICE or Black ICE -->
  <SoundDef>
    <defName>NR_Dive_ICE</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Dive/ice</clipPath></li></grains>
        <volumeRange>65~65</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- an AI wakes up -->
  <SoundDef>
    <defName>NR_AI_Awaken</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/awaken</clipPath></li></grains>
        <volumeRange>60~60</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- AI events with a message, wild AI in memory -->
  <SoundDef>
    <defName>NR_AI_Whisper</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/whisper</clipPath></li></grains>
        <volumeRange>40~40</volumeRange>
        <pitchRange>0.9~1.1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- an AI asks for something -->
  <SoundDef>
    <defName>NR_AI_Request</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/request</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- request fulfilled, trust grows -->
  <SoundDef>
    <defName>NR_AI_Fulfilled</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/fulfilled</clipPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- AI is hurt, request failed, escape -->
  <SoundDef>
    <defName>NR_AI_Angry</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/angry</clipPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- feeding an AI -->
  <SoundDef>
    <defName>NR_AI_Feed</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/feed</clipPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- small AI event, service done -->
  <SoundDef>
    <defName>NR_AI_Chime</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/chime</clipPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Echo AI (a dead colonist) speaks -->
  <SoundDef>
    <defName>NR_AI_Echo</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/AI/echo</clipPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- terminal open: low hum, fan, faint data pings -->
  <SoundDef>
    <defName>NR_Amb_Terminal</defName>
    <context>Any</context>
    <sustain>true</sustain>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Ambient/terminal</clipPath></li></grains>
        <volumeRange>28~28</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Gateway (cyberspace map): airy pad, sparse pings -->
  <SoundDef>
    <defName>NR_Amb_Cyberspace</defName>
    <context>Any</context>
    <sustain>true</sustain>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Ambient/cyberspace</clipPath></li></grains>
        <volumeRange>28~28</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- inside a dive: tense drone, rhythmic throb, riser -->
  <SoundDef>
    <defName>NR_Amb_Dive</defName>
    <context>Any</context>
    <sustain>true</sustain>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Ambient/dive</clipPath></li></grains>
        <volumeRange>30~30</volumeRange>
        <pitchRange>1~1</pitchRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

  <!-- AI server hum: a sound on the building (Building.soundAmbient of NR_AIServer, positional, fades with distance) -->
  <SoundDef>
    <defName>NR_Amb_Server</defName>
    <context>MapOnly</context>
    <sustain>true</sustain>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Netrun/Ambient/server</clipPath></li></grains>
        <volumeRange>22~22</volumeRange>
        <distRange>0~14</distRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
