<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Disassembly of Hacking Expansion cyberlink upgrades (docs/BALANCE_PLAN.md, section 2): 50% of the cyberdata and steel/plasteel, rounded down, min 1 data;
       components and uranium are lost. Yields assume the Costlier HE crafting costs (Patches/HE_Costs.xml); with the setting off they stay as is. -->
  <RecipeDef Name="NR_DisassembleUpgradeBase" Abstract="True">
    <workAmount>2500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers><li>TableMachining</li></recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="NR_DisassembleUpgradeBase">
    <defName>NR_Disassemble_JammerKit</defName>
    <label>disassemble jammer kit</label>
    <description>Strip a jammer kit for part of its cyberdata and metal. Components are lost.</description>
    <jobString>Disassembling jammer kit.</jobString>
    <researchPrerequisite>USH_BasicCybertech</researchPrerequisite>
    <ingredients><li><filter><thingDefs><li>USH_JammerKit</li></thingDefs></filter><count>1</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>USH_JammerKit</li></thingDefs></fixedIngredientFilter>
    <products>
      <USH_Cyberdata>5</USH_Cyberdata>
    </products>
  </RecipeDef>

