<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <AssemblyName>HackingExpansionNetrun</AssemblyName>
    <RootNamespace>Netrun</RootNamespace>
    <Version>0.5.0</Version>
    <Company>GafarovMaxim</Company>
    <Product>Hacking Expansion: Netrun</Product>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <RIMWORLD_DIR Condition="'$(RIMWORLD_DIR)' == ''">E:\SteamLibrary\steamapps\common\RimWorld</RIMWORLD_DIR>
    <WORKSHOP_DIR>$(RIMWORLD_DIR)\..\..\workshop\content\294100</WORKSHOP_DIR>
    <LocalGame Condition="Exists('$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll')">true</LocalGame>
  </PropertyGroup>

  <!-- Local build: the installed game, Harmony and Hacking Expansion from Steam. -->
  <ItemGroup Condition="'$(LocalGame)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RIMWORLD_DIR)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WORKSHOP_DIR)\2009463077\Current\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HackingExpansion">
      <HintPath>$(WORKSHOP_DIR)\3573344880\1.6\Assemblies\HackingExpansion.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- CI build (no game installed): reference packages plus the Hacking Expansion DLL downloaded to lib/. -->
  <ItemGroup Condition="'$(LocalGame)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" PrivateAssets="all" />
    <Reference Include="HackingExpansion">
      <HintPath>lib\HackingExpansion.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
